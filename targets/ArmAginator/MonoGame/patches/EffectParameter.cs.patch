         /// <summary>
         /// The current state key which is used to detect
 		/// if the parameter value has been changed.
         /// </summary>
         internal ulong StateKey { get; private set; }
+
+        // ArmAgedon: the constant buffers holding this parameter (and its index in each), told when it changes, so a buffer's
+        // Update copies only the changed parameters instead of checking every one of them at every pass Apply.
+        private ConstantBuffer[] _owners = Array.Empty<ConstantBuffer>();
+        private int[] _ownerSlots = Array.Empty<int>();
+
+        internal void AddOwner(ConstantBuffer buffer, int slot)
+        {
+            var n = _owners.Length;
+            Array.Resize(ref _owners, n + 1);
+            Array.Resize(ref _ownerSlots, n + 1);
+            _owners[n] = buffer;
+            _ownerSlots[n] = slot;
+        }
+
+        private void Changed()
+        {
+            StateKey = unchecked(NextStateKey++);
+            for (var i = 0; i < _owners.Length; i++)
+                _owners[i].MarkChanged(_ownerSlots[i]);
+        }
 
