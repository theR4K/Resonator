+// ArmAgedon: graphics-thread benchmark/resize diagnostics; no GPU work.
+MG_EXPORT mgint MGDX_GetBackbufferState(MGG_GraphicsDevice* device, mgint* values, mgint count)
+{
+    if (device == nullptr || device->resources == nullptr || values == nullptr || count < 6) return 0;
+    auto backbuffer = device->resources->GetMainTarget();
+    if (backbuffer == nullptr) return 0;
+    values[0] = (mgint)backbuffer->GetWidth();
+    values[1] = (mgint)backbuffer->GetHeight();
+    values[2] = (mgint)device->viewport.Width;
+    values[3] = (mgint)device->viewport.Height;
+    values[4] = (mgint)(device->scissor.right - device->scissor.left);
+    values[5] = (mgint)(device->scissor.bottom - device->scissor.top);
+    return 6;
 }
