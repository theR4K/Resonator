+// ArmAgedon: vertex and index buffers up to MGDX_POOL_MAX_BYTES are ranges of shared upload pages (MGDX_BufferPage), as the
+// Vulkan runtime's (MGVK_PoolAllocate); written in place like the Vulkan ones. ARMA_DX12_BUFFER_POOL=0: one resource each again
+static const UINT64 MGDX_POOL_PAGE_BYTES = 8ull * 1024 * 1024;
+static const int MGDX_POOL_MAX_BYTES = 256 * 1024;
+static const UINT64 MGDX_POOL_ALIGNMENT = 256;
+static const bool g_mgdxBufferPool = []() { const char* v = getenv("ARMA_DX12_BUFFER_POOL"); return v == nullptr || strcmp(v, "0") != 0; }();
+
+static bool MGDX_PoolAllocate(MGG_GraphicsDevice* device, int sizeInBytes, MGG_Buffer* buffer)
+{
+	D3D12MA::VIRTUAL_ALLOCATION_DESC range = {};
+	range.Size = (UINT64)sizeInBytes;
+	range.Alignment = MGDX_POOL_ALIGNMENT;
+	std::lock_guard lock(device->resourceMutex);
+	for (int attempt = 0; attempt < 2; attempt++)
+	{
+		for (auto* page : device->bufferPages)
+		{
+			if (MGDX_POOL_PAGE_BYTES - page->used < range.Size)
+				continue;
+			UINT64 offset = 0;
+			if (SUCCEEDED(page->block->Allocate(&range, &buffer->range, &offset)))
+			{
+				page->ranges++;
+				page->used += range.Size;
+				buffer->page = page;
+				buffer->poolOffset = offset;
+				buffer->m_res = page->res;
+				return true;
+			}
+		}
+		if (attempt > 0)
+			break;
+		auto* page = new MGDX_BufferPage();
+		auto resourceDesc = CD3DX12_RESOURCE_DESC::Buffer(MGDX_POOL_PAGE_BYTES);
+		D3D12MA::ALLOCATION_DESC allocDesc = {};
+		allocDesc.HeapType = D3D12_HEAP_TYPE_UPLOAD;
+		if (FAILED(device->resources->GetAllocator()->CreateResource(&allocDesc, &resourceDesc, D3D12_RESOURCE_STATE_GENERIC_READ,
+			nullptr, page->alloc.ReleaseAndGetAddressOf(), IID_GRAPHICS_PPV_ARGS(page->res.ReleaseAndGetAddressOf())))
+			|| FAILED(page->res->Map(0, nullptr, (void**)&page->mapped)))
+		{
+			delete page;
+			return false;
+		}
+		D3D12MA::VIRTUAL_BLOCK_DESC blockDesc = {};
+		blockDesc.Size = MGDX_POOL_PAGE_BYTES;
+		if (FAILED(D3D12MA::CreateVirtualBlock(&blockDesc, &page->block)))
+		{
+			page->res->Unmap(0, nullptr);
+			delete page;
+			return false;
+		}
+		device->bufferPages.push_back(page);
+	}
+	return false;
+}
