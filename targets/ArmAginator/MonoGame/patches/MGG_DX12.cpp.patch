+		auto resourceDesc = CD3DX12_RESOURCE_DESC::Buffer(MGDX_POOL_PAGE_BYTES);
+		D3D12MA::ALLOCATION_DESC allocDesc = {};
+		allocDesc.HeapType = D3D12_HEAP_TYPE_UPLOAD;
+		if (FAILED(device->resources->GetAllocator()->CreateResource(&allocDesc, &resourceDesc, D3D12_RESOURCE_STATE_GENERIC_READ,
+			nullptr, page->alloc.ReleaseAndGetAddressOf(), IID_GRAPHICS_PPV_ARGS(page->res.ReleaseAndGetAddressOf())))
+			|| FAILED(page->res->Map(0, nullptr, (void**)&page->mapped)))
