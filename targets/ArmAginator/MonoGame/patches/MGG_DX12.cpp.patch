+static bool MGDX_PoolAllocate(MGG_GraphicsDevice* device, int sizeInBytes, MGG_Buffer* buffer)
+{
+	D3D12MA::VIRTUAL_ALLOCATION_DESC range = {};
+	range.Size = (UINT64)sizeInBytes;
+	range.Alignment = MGDX_POOL_ALIGNMENT;
+	std::lock_guard lock(device->resourceMutex);
+	for (int attempt = 0; attempt < 2; attempt++)
+	{
+		for (auto* page : device->bufferPages)
+		{
+			if (MGDX_POOL_PAGE_BYTES - page->used < range.Size)
+				continue;
+			UINT64 offset = 0;
+			if (SUCCEEDED(page->block->Allocate(&range, &buffer->range, &offset)))
+			{
+				page->ranges++;
+				page->used += range.Size;
+				buffer->page = page;
+				buffer->poolOffset = offset;
+				buffer->m_res = page->res;
+				return true;
