+// ArmAgedon: graphics-thread benchmark/resize diagnostics; no GPU work.
+MG_EXPORT mgint MGDX_GetBackbufferState(MGG_GraphicsDevice* device, mgint* values, mgint count)
+{
+    if (device == nullptr || device->resources == nullptr || values == nullptr || count < 6) return 0;
+    auto backbuffer = device->resources->GetMainTarget();
+    if (backbuffer == nullptr) return 0;
+    values[0] = (mgint)backbuffer->GetWidth();
+    values[1] = (mgint)backbuffer->GetHeight();
+    values[2] = (mgint)device->viewport.Width;
+    values[3] = (mgint)device->viewport.Height;
+    values[4] = (mgint)(device->scissor.right - device->scissor.left);
+    values[5] = (mgint)(device->scissor.bottom - device->scissor.top);
+    return 6;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// ArmAgedon: GPU timestamps (ARMA_PASS_TIMES) and the per-draw profile (ARMA_GPU_DRAW_PROFILE=1) for D3D12, the Vulkan
+// runtime's MGVK_WriteTimestamp / MGVK_ReadTimestamps / MGVK_SetDrawTag / MGVK_DrawProfileCount / MGVK_ReadDrawProfile
+// with the same contracts under MGDX_ names. Each back buffer slot has a timestamp heap, a pipeline statistics heap and a
+// readback buffer; the frame's queries are resolved into it before Present closes the command list, and copied out when
+// the slot is next prepared (DeviceResources::Prepare waited for its fence by then).
+// ---------------------------------------------------------------------------------------------------------------------
+
+static const UINT MGDX_MAX_TIMESTAMPS = 128;
+static const UINT MGDX_MAX_PROFILED_DRAWS = 8192;
+
+struct MGDX_ProfileSlot
+{
+	Microsoft::WRL::ComPtr<ID3D12QueryHeap> times;     // MGDX_MAX_TIMESTAMPS pass timestamps
+	Microsoft::WRL::ComPtr<ID3D12QueryHeap> drawTimes; // MGDX_MAX_PROFILED_DRAWS + 1
+	Microsoft::WRL::ComPtr<ID3D12QueryHeap> stats;     // MGDX_MAX_PROFILED_DRAWS
+	Microsoft::WRL::ComPtr<ID3D12Resource> readback;   // pass timestamps, then draw timestamps, then statistics
+	UINT timeCount = 0;
+	UINT drawCount = 0;
+	bool resolved = false;
+	FrameCounter frame = 0;
+	std::vector<int32_t> tags;
+};
+
+struct MGDX_ProfileState
+{
+	bool timestamps = false; // on from the first MGDX_WriteTimestamp
+	bool failed = false;
+	int32_t tag = 0;
+	double nsPerTick = 0.0;
+	std::vector<MGDX_ProfileSlot> slots;
+	std::vector<uint64_t> lastTimes;
+	FrameCounter lastTimesFrame = 0;
+	std::vector<int32_t> lastTags;
+	std::vector<uint64_t> lastStats;
+	std::vector<uint64_t> lastDrawTimes;
+	FrameCounter lastDrawFrame = 0;
+};
+
+static std::map<MGG_GraphicsDevice*, MGDX_ProfileState> s_dxProfiles;
+
+static bool MGDX_DrawProfileRequested()
+{
+	static int on = -1;
+	if (on < 0)
+	{
+		const char* v = getenv("ARMA_GPU_DRAW_PROFILE");
+		on = v != nullptr && v[0] == '1' ? 1 : 0;
+	}
+	return on == 1;
+}
+
+static const UINT64 MGDX_READBACK_TIMES = 0;
+static const UINT64 MGDX_READBACK_DRAW_TIMES = MGDX_MAX_TIMESTAMPS * sizeof(uint64_t);
+static const UINT64 MGDX_READBACK_STATS = MGDX_READBACK_DRAW_TIMES + (MGDX_MAX_PROFILED_DRAWS + 1) * sizeof(uint64_t);
+static const UINT64 MGDX_READBACK_BYTES = MGDX_READBACK_STATS + MGDX_MAX_PROFILED_DRAWS * sizeof(D3D12_QUERY_DATA_PIPELINE_STATISTICS);
+
+static bool MGDX_ProfileCreateSlot(MGG_GraphicsDevice* device, MGDX_ProfileSlot& slot)
+{
+	auto d3d = device->resources->GetD3DDevice();
+	D3D12_QUERY_HEAP_DESC desc = {};
+	desc.Type = D3D12_QUERY_HEAP_TYPE_TIMESTAMP;
+	desc.Count = MGDX_MAX_TIMESTAMPS;
+	if (FAILED(d3d->CreateQueryHeap(&desc, IID_PPV_ARGS(&slot.times))))
+		return false;
+	desc.Count = MGDX_MAX_PROFILED_DRAWS + 1;
+	if (FAILED(d3d->CreateQueryHeap(&desc, IID_PPV_ARGS(&slot.drawTimes))))
+		return false;
+	desc.Type = D3D12_QUERY_HEAP_TYPE_PIPELINE_STATISTICS;
+	desc.Count = MGDX_MAX_PROFILED_DRAWS;
+	if (FAILED(d3d->CreateQueryHeap(&desc, IID_PPV_ARGS(&slot.stats))))
+		return false;
+	CD3DX12_HEAP_PROPERTIES heap(D3D12_HEAP_TYPE_READBACK);
+	auto bufferDesc = CD3DX12_RESOURCE_DESC::Buffer(MGDX_READBACK_BYTES);
+	return SUCCEEDED(d3d->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &bufferDesc, D3D12_RESOURCE_STATE_COPY_DEST,
+		nullptr, IID_PPV_ARGS(&slot.readback)));
+}
+
+// After DeviceResources::Prepare: the slot's previous results are complete; copy them out and start this frame's.
+static void MGDX_ProfileBeginFrame(MGG_GraphicsDevice* device)
+{
+	auto it = s_dxProfiles.find(device);
+	bool draws = MGDX_DrawProfileRequested();
+	if (it == s_dxProfiles.end() && !draws)
+		return;
+	auto& state = s_dxProfiles[device];
+	if (state.failed || (!state.timestamps && !draws) || device->begin_frame_index < 0)
+		return;
+	if (state.nsPerTick == 0.0)
+	{
+		UINT64 frequency = 0;
+		if (FAILED(device->resources->GetCommandQueue()->Get()->GetTimestampFrequency(&frequency)) || frequency == 0)
+		{
+			state.failed = true;
+			return;
+		}
+		state.nsPerTick = 1e9 / (double)frequency;
+	}
+	size_t index = (size_t)device->begin_frame_index;
+	if (state.slots.size() <= index)
+		state.slots.resize(index + 1);
+	auto& slot = state.slots[index];
+	if (slot.readback == nullptr)
+	{
+		if (!MGDX_ProfileCreateSlot(device, slot))
+		{
+			state.failed = true;
+			return;
+		}
+	}
+	else if (slot.resolved)
+	{
+		uint8_t* data = nullptr;
+		D3D12_RANGE range = { 0, (SIZE_T)MGDX_READBACK_BYTES };
+		if (SUCCEEDED(slot.readback->Map(0, &range, (void**)&data)))
+		{
+			if (slot.timeCount > 0)
+			{
+				auto t = (const uint64_t*)(data + MGDX_READBACK_TIMES);
+				state.lastTimes.assign(t, t + slot.timeCount);
+				state.lastTimesFrame = slot.frame;
+			}
+			if (slot.drawCount > 0)
+			{
+				auto t = (const uint64_t*)(data + MGDX_READBACK_DRAW_TIMES);
+				state.lastDrawTimes.assign(t, t + slot.drawCount + 1);
+				auto s = (const D3D12_QUERY_DATA_PIPELINE_STATISTICS*)(data + MGDX_READBACK_STATS);
+				state.lastStats.resize((size_t)slot.drawCount * 3);
+				for (UINT i = 0; i < slot.drawCount; i++)
+				{
+					state.lastStats[(size_t)i * 3] = s[i].VSInvocations;
+					state.lastStats[(size_t)i * 3 + 1] = s[i].CPrimitives;
+					state.lastStats[(size_t)i * 3 + 2] = s[i].PSInvocations;
+				}
+				state.lastTags = slot.tags;
+				state.lastDrawFrame = slot.frame;
+			}
+			D3D12_RANGE none = { 0, 0 };
+			slot.readback->Unmap(0, &none);
+		}
+	}
+	slot.timeCount = 0;
+	slot.drawCount = 0;
+	slot.resolved = false;
+	slot.frame = device->frame;
+	slot.tags.clear();
+	if (draws)
+		device->context->GetCommandList()->EndQuery(slot.drawTimes.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0);
+}
+
+static MGDX_ProfileSlot* MGDX_ProfileSlotForFrame(MGG_GraphicsDevice* device, MGDX_ProfileState** stateOut = nullptr)
+{
+	auto it = s_dxProfiles.find(device);
+	if (it == s_dxProfiles.end() || it->second.failed || device->begin_frame_index < 0
+		|| (size_t)device->begin_frame_index >= it->second.slots.size())
+		return nullptr;
+	auto& slot = it->second.slots[device->begin_frame_index];
+	if (slot.readback == nullptr || slot.frame != device->frame || slot.resolved || !device->is_recording)
+		return nullptr;
+	if (stateOut != nullptr)
+		*stateOut = &it->second;
+	return &slot;
+}
+
+// Before Present closes the command list: the frame's queries into the readback buffer.
+static void MGDX_ProfileEndFrame(MGG_GraphicsDevice* device)
+{
+	auto slot = MGDX_ProfileSlotForFrame(device);
+	if (slot == nullptr)
+		return;
+	auto cl = device->context->GetCommandList();
+	if (slot->timeCount > 0)
+		cl->ResolveQueryData(slot->times.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0, slot->timeCount, slot->readback.Get(), MGDX_READBACK_TIMES);
+	if (MGDX_DrawProfileRequested())
+	{
+		cl->ResolveQueryData(slot->drawTimes.Get(), D3D12_QUERY_TYPE_TIMESTAMP, 0, slot->drawCount + 1, slot->readback.Get(), MGDX_READBACK_DRAW_TIMES);
+		if (slot->drawCount > 0)
+			cl->ResolveQueryData(slot->stats.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS, 0, slot->drawCount, slot->readback.Get(), MGDX_READBACK_STATS);
+	}
+	slot->resolved = true;
+}
 
+static bool MGDX_DrawProfileBegin(MGG_GraphicsDevice* device)
+{
+	if (!MGDX_DrawProfileRequested())
+		return false;
+	auto slot = MGDX_ProfileSlotForFrame(device);
+	if (slot == nullptr || slot->drawCount >= MGDX_MAX_PROFILED_DRAWS)
+		return false;
+	device->context->GetCommandList()->BeginQuery(slot->stats.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS, slot->drawCount);
 	return true;
+}
+
+static void MGDX_DrawProfileEnd(MGG_GraphicsDevice* device)
+{
+	MGDX_ProfileState* state = nullptr;
+	auto slot = MGDX_ProfileSlotForFrame(device, &state);
+	if (slot == nullptr)
+		return;
+	auto cl = device->context->GetCommandList();
+	cl->EndQuery(slot->stats.Get(), D3D12_QUERY_TYPE_PIPELINE_STATISTICS, slot->drawCount);
+	cl->EndQuery(slot->drawTimes.Get(), D3D12_QUERY_TYPE_TIMESTAMP, slot->drawCount + 1);
+	slot->tags.push_back(state->tag);
+	slot->drawCount++;
+}
+
+/// Writes a GPU timestamp after the commands recorded so far; its index in this frame, or -1 (timestamps start with the
+/// frame after the first call).
+MG_EXPORT mgint MGDX_WriteTimestamp(MGG_GraphicsDevice* device)
+{
+	assert(device != nullptr);
+	auto& state = s_dxProfiles[device];
+	if (!state.timestamps)
+	{
+		state.timestamps = true;
+		return -1;
+	}
+	auto slot = MGDX_ProfileSlotForFrame(device);
+	if (slot == nullptr || slot->timeCount >= MGDX_MAX_TIMESTAMPS)
+		return -1;
+	device->context->GetCommandList()->EndQuery(slot->times.Get(), D3D12_QUERY_TYPE_TIMESTAMP, slot->timeCount);
+	return (mgint)slot->timeCount++;
+}
+
+/// The frame being recorded (MGDX_ReadTimestamps reports which frame its values are from).
+MG_EXPORT uint64_t MGDX_CurrentFrame(MGG_GraphicsDevice* device)
+{
+	assert(device != nullptr);
+	return device->frame;
+}
+
+/// The timestamps of the last frame whose results came back (each once): how many were copied into values (up to max),
+/// the frame they were written in, and the nanoseconds per timestamp tick.
+MG_EXPORT mgint MGDX_ReadTimestamps(MGG_GraphicsDevice* device, uint64_t* frame, uint64_t* values, mgint max, float* nsPerTick)
+{
+	assert(device != nullptr);
+	auto it = s_dxProfiles.find(device);
+	*nsPerTick = it != s_dxProfiles.end() ? (float)it->second.nsPerTick : 0.0f;
+	if (it == s_dxProfiles.end())
+		return 0;
+	auto& state = it->second;
+	mgint count = (mgint)std::min<size_t>((size_t)max, state.lastTimes.size());
+	for (mgint i = 0; i < count; i++)
+		values[i] = state.lastTimes[i];
+	*frame = state.lastTimesFrame;
+	state.lastTimes.clear();
+	return count;
+}
+
+/// The tag the next draws are recorded with (ARMA_GPU_DRAW_PROFILE); the renderer maps it to its name.
+MG_EXPORT void MGDX_SetDrawTag(MGG_GraphicsDevice* device, mgint tag)
+{
+	if (MGDX_DrawProfileRequested())
+		s_dxProfiles[device].tag = tag;
+}
+
+/// The draws profiled so far in the frame being recorded (the renderer's section boundaries).
+MG_EXPORT mgint MGDX_DrawProfileCount(MGG_GraphicsDevice* device)
+{
+	auto slot = MGDX_ProfileSlotForFrame(device);
+	return slot != nullptr ? (mgint)slot->drawCount : 0;
+}
+
+/// The last frame whose profile came back (each once): its draw count (up to max), the frame it was recorded in, each
+/// draw's tag, its three statistics (vertex shader invocations, clipped primitives, pixel shader invocations) and
+/// count + 1 timestamps (times[0]: the frame's start; times must hold max + 1), and the nanoseconds per timestamp tick.
+MG_EXPORT mgint MGDX_ReadDrawProfile(MGG_GraphicsDevice* device, uint64_t* frame, int32_t* tags, uint64_t* stats,
+	uint64_t* times, mgint max, float* nsPerTick)
+{
+	auto it = s_dxProfiles.find(device);
+	*nsPerTick = it != s_dxProfiles.end() ? (float)it->second.nsPerTick : 0.0f;
+	if (it == s_dxProfiles.end() || it->second.lastTags.empty())
+		return 0;
+	auto& state = it->second;
+	mgint count = (mgint)std::min<size_t>((size_t)max, state.lastTags.size());
+	for (mgint i = 0; i < count; i++)
+	{
+		tags[i] = state.lastTags[i];
+		stats[i * 3] = state.lastStats[(size_t)i * 3];
+		stats[i * 3 + 1] = state.lastStats[(size_t)i * 3 + 1];
+		stats[i * 3 + 2] = state.lastStats[(size_t)i * 3 + 2];
+	}
+	for (mgint i = 0; i <= count; i++)
+		times[i] = state.lastDrawTimes[i];
+	*frame = state.lastDrawFrame;
+	state.lastTags.clear();
+	return count;
 }
