+/// ArmAgedon: gives a pooled buffer's range back (once the GPU is done with it, from the destroy queue); an empty page goes.
+static void MGDX_PoolFree(MGG_GraphicsDevice* device, MGG_Buffer* buffer)
+{
+	auto* page = buffer->page;
+	D3D12MA::VIRTUAL_ALLOCATION_INFO info = {};
+	page->block->GetAllocationInfo(buffer->range, &info);
+	page->block->FreeAllocation(buffer->range);
+	page->ranges--;
+	page->used -= info.Size;
+	buffer->page = nullptr;
+	buffer->m_res.Reset();
+	if (page->ranges == 0)
+	{
+		device->bufferPages.erase(std::remove(device->bufferPages.begin(), device->bufferPages.end(), page), device->bufferPages.end());
+		page->block->Release();
+		page->res->Unmap(0, nullptr);
+		delete page;
+	}
+}
 
