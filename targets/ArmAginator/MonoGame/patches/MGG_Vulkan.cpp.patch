+}
+
+// ArmAgedon vk-texture-set: pixel shaders take their textures from a set of their own (ARMA_VK_TEXTURE_SET=0: no), so
+// material sets work
+MG_EXPORT mgbool MGVK_TextureSetEnabled(MGG_GraphicsDevice* device)
+{
+	return device != nullptr && device->textureSetSplit;
+}
+
+// ArmAgedon vk-texture-set: a material's pixel textures and samplers: textures[i] / samplers[i] for every slot i of `mask`
+// (a null texture reads the shader's null texture; samplers must be set). Its descriptor sets are written on first use per
+// pixel shader layout and kept until MGVK_MaterialSet_Destroy.
+MG_EXPORT MGVK_MaterialSet* MGVK_MaterialSet_Create(MGG_GraphicsDevice* device, mguint mask, MGG_Texture** textures, MGG_SamplerState** samplers)
+{
+	if (device == nullptr || textures == nullptr || samplers == nullptr)
+		return nullptr;
+	mask &= (1u << MAX_TEXTURE_SLOTS) - 1;
+	for (int i = 0; i < MAX_TEXTURE_SLOTS; i++)
+	{
+		if (((mask >> i) & 1) && samplers[i] == nullptr)
+			return nullptr;
+	}
+	auto set = new MGVK_MaterialSet();
+	set->mask = mask;
+	for (int i = 0; i < MAX_TEXTURE_SLOTS; i++)
+	{
+		if ((mask >> i) & 1)
+		{
+			set->textures[i] = textures[i];
+			set->samplers[i] = samplers[i];
+		}
+	}
+	device->materialSets.push_back(set);
+	return set;
+}
+
+// ArmAgedon vk-texture-set: its descriptor sets are released once the frames in flight are done with them. Its textures
+// may be destroyed after this call (the frames that used them keep them alive, as for any bound texture).
+MG_EXPORT void MGVK_MaterialSet_Destroy(MGG_GraphicsDevice* device, MGVK_MaterialSet* set)
+{
+	if (device == nullptr || set == nullptr || set->retired)
+		return;
+	if (device->material == set)
+	{
+		device->material = nullptr;
+		device->textureSamplerDirty = 0xFFFFFFFF;
+	}
+	set->retired = true;
+	mg_remove(device->materialSets, set);
+	device->retiredMaterialSets.push_back(set);
+}
+
+// ArmAgedon vk-texture-set: the following draws take the pixel textures of the set's mask from `set` instead of the
+// texture slots (null: from the slots again). Draws with an unsplit pixel shader ignore it.
+MG_EXPORT void MGVK_BindMaterialSet(MGG_GraphicsDevice* device, MGVK_MaterialSet* set)
+{
+	if (device->material == set)
+		return;
+	device->material = set;
+	device->textureSamplerDirty = 0xFFFFFFFF;
+	device->uniformsDirty = 0xFFFFFFFF;
+}
+
+// ArmAgedon vk-texture-set (plan 2.1): the material's constant buffer for register `reg` (b0..b7): `size` bytes, used in place
+// of the bound effect's buffer of that register (when it has that size) while the set is bound. Again: new contents; no
+// data: none (the effect's buffer).
+MG_EXPORT mgint MGVK_MaterialSet_SetConstants(MGG_GraphicsDevice* device, MGVK_MaterialSet* set, mgint reg, mgbyte* data, mgint size)
+{
+	if (device == nullptr || set == nullptr || set->retired || reg < 0 || reg >= MGVK_MAX_UNIFORM_SLOTS)
+		return -1;
+	MGG_Buffer*& cb = set->cbuffers[reg];
+	if (data == nullptr || size <= 0) // none: the effect's buffer again
+	{
+		if (cb != nullptr)
+			MGG_Buffer_Destroy(device, cb);
+		cb = nullptr;
+		if (device->material == set)
+			device->uniformsDirty = 0xFFFFFFFF;
+		return 0;
+	}
+	if (cb != nullptr && cb->dataSize != size)
+	{
+		MGG_Buffer_Destroy(device, cb);
+		cb = nullptr;
+	}
+	if (cb == nullptr)
+		cb = MGG_Buffer_Create(device, MGBufferType::Constant, true, size);
+	if (cb == nullptr)
+		return -1;
+	MGG_Buffer_SetData(device, cb, 0, data, 1, size, size, true);
+	if (device->material == set)
+		device->uniformsDirty = 0xFFFFFFFF;
+	return 0;
+}
+
+// ArmAgedon vk-xr-direct-copy: one layer (one eye) of a layered render target straight into one layer of a stereo
+// swapchain image, without the eye target in between.
+MG_EXPORT mgint MGVK_RecordCopyLayerToExternalImageLayer(MGG_GraphicsDevice* device, MGG_Texture* source, mgint layer, uint64_t externalImage, mgint externalFormat, mgint width, mgint height, mgbool flipY, mgint dstLayer)
+{
+	return layer < 0 || dstLayer < 0 || dstLayer > 1 ? -1 : MGVK_RecordCopyImpl(device, source, externalImage, externalFormat, width, height, flipY, (uint32_t)layer,
+		VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_IMAGE_LAYOUT_MAX_ENUM, (uint32_t)dstLayer);
+}
+
+// ArmAgedon vk-multiview: MGVK_RecordCopyToExternalImage from one layer (one eye) of a layered render target.
+MG_EXPORT mgint MGVK_RecordCopyLayerToExternalImage(MGG_GraphicsDevice* device, MGG_Texture* source, mgint layer, uint64_t externalImage, mgint externalFormat, mgint width, mgint height, mgbool flipY)
+{
+	return layer < 0 ? -1 : MGVK_RecordCopyImpl(device, source, externalImage, externalFormat, width, height, flipY, (uint32_t)layer);
+}
+
+// ArmAgedon vk-multiview: one layer of a layered render target copied into another render target of its size (a plain
+// eye target the post passes and the XR copy read), recorded into the frame. 0: done; < 0: not copyable.
+MG_EXPORT mgint MGVK_CopyTargetLayer(MGG_GraphicsDevice* device, MGG_Texture* source, mgint layer, MGG_Texture* dest)
+{
+	if (dest == nullptr || !dest->isTarget || dest->image == VK_NULL_HANDLE || dest->multiSampleCount > 1 || layer < 0)
+		return -3;
+	// a target not used yet: from UNDEFINED (the copy covers it all), left readable like a target after its pass
+	VkImageLayout dstOld = dest->layouts[0];
+	VkImageLayout dstLayout = dstOld == VK_IMAGE_LAYOUT_UNDEFINED ? VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL : dstOld;
+	mgint r = MGVK_RecordCopyImpl(device, source, (uint64_t)dest->image, (mgint)dest->info.format,
+		(mgint)dest->info.extent.width, (mgint)dest->info.extent.height, false, (uint32_t)layer, dstLayout, dstOld);
+	if (r == 0)
+	{
+		dest->layouts[0] = dstLayout;
+		dest->writeFrame = device->frame; // written this frame: a later pass into it loads the copy
+	}
+	return r;
+}
+
+// ArmAgedon vk-depth-copy: the depth of `target`'s depth buffer (as drawn so far this frame) copied into `dest`, an R32F
+// texture of its size with at least as many layers (one per multiview view), recorded into the frame: the scene depth a
+// shader can sample without an eye-depth prepass (FogBox on the Steam Frame, where that prepass is off). The values are
+// the depth buffer's own (the renderer's reversed-Z), not eye depth. The render pass ends; the next draw starts a new
+// one that loads what is there. Depth goes through a buffer: an image copy cannot change depth into a color format.
+// 0: done; < 0: not copyable (no depth buffer, a format without a 32-bit float depth, sizes or layers that do not match).
+MG_EXPORT mgint MGVK_CopyTargetDepth(MGG_GraphicsDevice* device, MGG_Texture* target, MGG_Texture* dest)
+{
+	assert(device != nullptr);
+	MGVK_EnsureTargetDepth(device, target); // ArmAgedon memory: a requested depth read realizes any deferred clear
+	MGG_Texture* depth = target != nullptr ? target->depthTexture : nullptr;
+	if (depth == nullptr || depth->image == VK_NULL_HANDLE || depth->multiSampleCount > 1)
+		return -1;
+	if (depth->info.format != VK_FORMAT_D32_SFLOAT && depth->info.format != VK_FORMAT_D32_SFLOAT_S8_UINT)
+		return -2;
+	if (dest == nullptr || dest->image == VK_NULL_HANDLE || dest->info.format != VK_FORMAT_R32_SFLOAT
+		|| dest->info.extent.width != depth->info.extent.width || dest->info.extent.height != depth->info.extent.height
+		|| dest->info.arrayLayers < depth->info.arrayLayers)
+		return -3;
+	auto& frame = device->frames[device->frameIndex];
+	if (!frame.is_recording)
+		return -4;
+	VkCommandBuffer cmd = frame.commandBuffer;
+	MGVK_EndRenderPass(device, cmd);
+
+	uint32_t w = depth->info.extent.width, h = depth->info.extent.height, layers = depth->info.arrayLayers;
+	VkDeviceSize size = (VkDeviceSize)w * h * layers * 4;
+	if (size > device->depthCopySize)
+	{
+		if (device->depthCopyBuffer != VK_NULL_HANDLE)
+			device->depthCopyRetired.push_back({ device->depthCopyBuffer, device->depthCopyAllocation });
+		VkBufferCreateInfo bufferInfo = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+		bufferInfo.size = size;
+		bufferInfo.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+		bufferInfo.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+		VmaAllocationCreateInfo allocInfo = {};
+		allocInfo.usage = VMA_MEMORY_USAGE_GPU_ONLY;
+		if (vmaCreateBuffer(device->allocator, &bufferInfo, &allocInfo, &device->depthCopyBuffer, &device->depthCopyAllocation, nullptr) != VK_SUCCESS)
+		{
+			device->depthCopyBuffer = VK_NULL_HANDLE;
+			device->depthCopySize = 0;
+			return -5;
+		}
+		device->depthCopySize = size;
+	}
+
+	VkImageAspectFlags depthAspects = DetermineAspectMask(depth->info.format);
+	VkImageLayout dstOld = dest->layouts[0];
+	VkImageMemoryBarrier barriers[2] = {};
+	for (auto& b : barriers)
+	{
+		b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+		b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	}
+	barriers[0].image = depth->image;
+	barriers[0].subresourceRange = { depthAspects, 0, 1, 0, layers };
+	barriers[0].oldLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL; // every pass leaves it so (finalLayout)
+	barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+	barriers[0].srcAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+	barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+	barriers[1].image = dest->image;
+	barriers[1].subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, layers };
+	barriers[1].oldLayout = dstOld; // UNDEFINED until the first copy (the copy covers it all)
+	barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barriers[1].srcAccessMask = VK_ACCESS_SHADER_READ_BIT;
+	barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+		VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+
+	VkBufferImageCopy region = {};
+	region.imageSubresource = { VK_IMAGE_ASPECT_DEPTH_BIT, 0, 0, layers };
+	region.imageExtent = { w, h, 1 };
+	vkCmdCopyImageToBuffer(cmd, depth->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, device->depthCopyBuffer, 1, &region);
+
+	VkBufferMemoryBarrier bufferBarrier = { VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER };
+	bufferBarrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	bufferBarrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+	bufferBarrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	bufferBarrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	bufferBarrier.buffer = device->depthCopyBuffer;
+	bufferBarrier.size = VK_WHOLE_SIZE;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 1, &bufferBarrier, 0, nullptr);
+
+	region.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, layers };
+	vkCmdCopyBufferToImage(cmd, device->depthCopyBuffer, dest->image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+
+	barriers[0].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+	barriers[0].newLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+	barriers[0].srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+	barriers[0].dstAccessMask = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+	barriers[1].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barriers[1].newLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+	barriers[1].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	barriers[1].dstAccessMask = VK_ACCESS_SHADER_READ_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+		VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+		0, 0, nullptr, 0, nullptr, 2, barriers);
+	dest->layouts[0] = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+	dest->writeFrame = device->frame; // ArmAgedon memory: GetData must submit this frame before reading the copy
+	dest->frame = device->frame;
+	depth->frame = device->frame;
+	return 0;
+}
+
+// ArmAgedon vk-multiview: whether the device has multiview on (MGVK_SetRenderTargetMultiview can succeed).
+MG_EXPORT mgbool MGVK_MultiviewEnabled(MGG_GraphicsDevice* device)
+{
+	return device != nullptr && device->multiviewEnabled;
+}
+
+// ArmAgedon vk-multiview: a render target of at least `views` layers becomes a multiview target: a render pass into it
+// (the whole target bound, not one layer) draws every draw into each of the first `views` layers, the vertex shader
+// picking the view by SV_ViewID (SPIR-V ViewIndex). Its depth target gets that many layers. Call before its first use.
+// 0: done; 1: the device has no multiview; 2: not a render target with enough layers, or views out of range.
+MG_EXPORT mgint MGVK_SetRenderTargetMultiview(MGG_GraphicsDevice* device, MGG_Texture* texture, mgint views)
+{
+	assert(device != nullptr);
+	if (!device->multiviewEnabled)
+		return 1;
+	if (texture == nullptr || !texture->isTarget || views < 2 || views > 6 || texture->info.arrayLayers < (uint32_t)views || texture->multiSampleCount > 1)
+		return 2;
+	MGG_Texture* depth = texture->depthTexture;
+	if (depth != nullptr && depth->info.arrayLayers < (uint32_t)views)
+	{
+		VkFormat format = depth->info.format;
+		uint32_t width = depth->info.extent.width, height = depth->info.extent.height;
+		mgint samples = depth->multiSampleCount;
+		MGG_Texture_Destroy(device, depth);
+		texture->depthTexture = CreateDepthTexture(device, format, width, height, samples, (uint32_t)views);
+		VK_SET_OBJECT_NAME(device->device, texture->depthTexture->image, VK_OBJECT_TYPE_IMAGE, "MGG_Texture.depthTexture.image (multiview RT id: %llu)", texture->id);
+		texture->depthTexture->target_view = CreateImageView(device, texture->depthTexture, 1);
+	}
+	texture->viewMask = (1u << views) - 1;
+	return 0;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// ArmAgedon: GPU timestamps for frame timings. Off until MGVK_WriteTimestamp is first called. Each frame in flight has a
+// query pool, reset when that frame begins recording; the results of the frame that used it before are copied out first
+// (its fence was waited for by then) and read with MGVK_ReadTimestamps. Patch kept in ArmAgedon/MonoGameRuntime/.
+// ---------------------------------------------------------------------------------------------------------------------
+
+#include <unordered_map>
+
+static const uint32_t MGVK_MAX_TIMESTAMPS = 128;
+
+struct MGVK_TimestampSlot
+{
+	VkQueryPool pool = VK_NULL_HANDLE;
+	uint32_t count = 0;
+	FrameCounter frame = 0;
+};
+
+struct MGVK_TimestampState
+{
+	bool enabled = false;
+	std::vector<MGVK_TimestampSlot> slots;
+	std::vector<uint64_t> last;
+	FrameCounter lastFrame = 0;
+};
+
+static std::unordered_map<MGG_GraphicsDevice*, MGVK_TimestampState> s_timestamps;
+
+static void MGVK_TimestampsBeginFrame(MGG_GraphicsDevice* device, VkCommandBuffer commandBuffer)
+{
+	auto it = s_timestamps.find(device);
+	if (it == s_timestamps.end() || !it->second.enabled)
+		return;
+	auto& state = it->second;
+	if (state.slots.size() < device->swapchainCount)
+		state.slots.resize(device->swapchainCount);
+	auto& slot = state.slots[device->frameIndex];
+	if (slot.pool == VK_NULL_HANDLE)
+	{
+		VkQueryPoolCreateInfo createInfo = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+		createInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;
+		createInfo.queryCount = MGVK_MAX_TIMESTAMPS;
+		if (vkCreateQueryPool(device->device, &createInfo, nullptr, &slot.pool) != VK_SUCCESS)
+		{
+			slot.pool = VK_NULL_HANDLE;
+			state.enabled = false;
+			return;
+		}
+	}
+	else if (slot.count > 0)
+	{
+		state.last.assign(slot.count, 0);
+		VkResult res = vkGetQueryPoolResults(device->device, slot.pool, 0, slot.count, sizeof(uint64_t) * slot.count,
+			state.last.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+		if (res == VK_SUCCESS)
+			state.lastFrame = slot.frame;
+		else
+			state.last.clear();
+	}
+	vkCmdResetQueryPool(commandBuffer, slot.pool, 0, MGVK_MAX_TIMESTAMPS);
+	slot.count = 0;
+	slot.frame = device->frame;
+}
+
+/// Writes a GPU timestamp after the commands recorded so far; its index in this frame, or -1 (timestamps start with the
+/// frame after the first call, or the device has none).
+MG_EXPORT mgint MGVK_WriteTimestamp(MGG_GraphicsDevice* device)
+{
+	assert(device != nullptr);
+	if (!device->deviceProperties.limits.timestampComputeAndGraphics)
+		return -1;
+	auto& state = s_timestamps[device];
+	if (!state.enabled)
+	{
+		state.enabled = true;
+		return -1;
+	}
+	if (device->frameIndex >= state.slots.size())
+		return -1;
+	auto& slot = state.slots[device->frameIndex];
+	auto& frame = device->frames[device->frameIndex];
+	if (slot.pool == VK_NULL_HANDLE || slot.frame != device->frame || slot.count >= MGVK_MAX_TIMESTAMPS || !frame.is_recording)
+		return -1;
+	vkCmdWriteTimestamp(frame.commandBuffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, slot.pool, slot.count);
+	return (mgint)slot.count++;
+}
+
+// ArmAgedon: ARMA_GPU_DRAW_PROFILE=1: every draw gets a pipeline statistics query (vertex shader invocations, primitives
+// after clipping, fragment shader invocations) and a timestamp after it, with the tag the renderer set last
+// (MGVK_SetDrawTag). Timestamp 0 is written when the frame begins, so draw i took times[i + 1] - times[i]: its own work
+// plus whatever ran between it and the previous draw (clears, resolves, copies, render pass changes). The results of a
+// frame are copied out when its slot is reused (its fence was waited for by then) and read with MGVK_ReadDrawProfile.
+// Under GMEM (tiled) rendering a timestamp inside a render pass is the last tile's: profile with TU_DEBUG=sysmem.
+
+static const uint32_t MGVK_MAX_PROFILED_DRAWS = 8192;
+
+struct MGVK_DrawProfileSlot
+{
+	VkQueryPool stats = VK_NULL_HANDLE;
+	VkQueryPool times = VK_NULL_HANDLE;
+	uint32_t count = 0;
+	FrameCounter frame = 0;
+	std::vector<int32_t> tags;
+};
+
+struct MGVK_DrawProfileState
+{
+	bool failed = false;
+	int32_t tag = 0;
+	std::vector<MGVK_DrawProfileSlot> slots;
+	std::vector<int32_t> lastTags;
+	std::vector<uint64_t> lastStats;
+	std::vector<uint64_t> lastTimes;
+	FrameCounter lastFrame = 0;
+};
+
+static std::unordered_map<MGG_GraphicsDevice*, MGVK_DrawProfileState> s_drawProfiles;
+
+static bool MGVK_DrawProfileRequested()
+{
+	static int on = -1;
+	if (on < 0)
+	{
+		const char* v = getenv("ARMA_GPU_DRAW_PROFILE");
+		on = v != nullptr && v[0] == '1' ? 1 : 0;
+	}
+	return on == 1;
+}
+
+static void MGVK_DrawProfileBeginFrame(MGG_GraphicsDevice* device, VkCommandBuffer commandBuffer)
+{
+	if (!MGVK_DrawProfileRequested() || !device->deviceFeatures.pipelineStatisticsQuery
+		|| !device->deviceProperties.limits.timestampComputeAndGraphics)
+		return;
+	auto& state = s_drawProfiles[device];
+	if (state.failed)
+		return;
+	if (state.slots.size() < device->swapchainCount)
+		state.slots.resize(device->swapchainCount);
+	auto& slot = state.slots[device->frameIndex];
+	if (slot.stats == VK_NULL_HANDLE)
+	{
+		VkQueryPoolCreateInfo statsInfo = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+		statsInfo.queryType = VK_QUERY_TYPE_PIPELINE_STATISTICS;
+		statsInfo.queryCount = MGVK_MAX_PROFILED_DRAWS;
+		statsInfo.pipelineStatistics = VK_QUERY_PIPELINE_STATISTIC_VERTEX_SHADER_INVOCATIONS_BIT
+			| VK_QUERY_PIPELINE_STATISTIC_CLIPPING_PRIMITIVES_BIT | VK_QUERY_PIPELINE_STATISTIC_FRAGMENT_SHADER_INVOCATIONS_BIT;
+		VkQueryPoolCreateInfo timesInfo = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+		timesInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;
+		timesInfo.queryCount = MGVK_MAX_PROFILED_DRAWS + 1;
+		if (vkCreateQueryPool(device->device, &statsInfo, nullptr, &slot.stats) != VK_SUCCESS
+			|| vkCreateQueryPool(device->device, &timesInfo, nullptr, &slot.times) != VK_SUCCESS)
+		{
+			state.failed = true;
+			return;
+		}
+	}
+	else if (slot.count > 0)
+	{
+		state.lastStats.assign((size_t)slot.count * 3, 0);
+		state.lastTimes.assign((size_t)slot.count + 1, 0);
+		VkResult a = vkGetQueryPoolResults(device->device, slot.stats, 0, slot.count, sizeof(uint64_t) * 3 * slot.count,
+			state.lastStats.data(), sizeof(uint64_t) * 3, VK_QUERY_RESULT_64_BIT);
+		VkResult b = vkGetQueryPoolResults(device->device, slot.times, 0, slot.count + 1, sizeof(uint64_t) * (slot.count + 1),
+			state.lastTimes.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+		if (a == VK_SUCCESS && b == VK_SUCCESS)
+		{
+			state.lastTags = slot.tags;
+			state.lastFrame = slot.frame;
+		}
+		else
+		{
+			state.lastTags.clear();
+		}
+	}
+	vkCmdResetQueryPool(commandBuffer, slot.stats, 0, MGVK_MAX_PROFILED_DRAWS);
+	vkCmdResetQueryPool(commandBuffer, slot.times, 0, MGVK_MAX_PROFILED_DRAWS + 1);
+	vkCmdWriteTimestamp(commandBuffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, slot.times, 0);
+	slot.count = 0;
+	slot.frame = device->frame;
+	slot.tags.clear();
+}
+
+static bool MGVK_DrawProfileBegin(MGG_GraphicsDevice* device, VkCommandBuffer commandBuffer)
+{
+	if (!MGVK_DrawProfileRequested())
+		return false;
+	auto it = s_drawProfiles.find(device);
+	if (it == s_drawProfiles.end() || it->second.failed || device->frameIndex >= it->second.slots.size())
+		return false;
+	auto& slot = it->second.slots[device->frameIndex];
+	if (slot.stats == VK_NULL_HANDLE || slot.frame != device->frame || slot.count >= MGVK_MAX_PROFILED_DRAWS)
+		return false;
+	vkCmdBeginQuery(commandBuffer, slot.stats, slot.count, 0);
+	return true;
+}
+
+static void MGVK_DrawProfileEnd(MGG_GraphicsDevice* device, VkCommandBuffer commandBuffer)
+{
+	auto& state = s_drawProfiles[device];
+	auto& slot = state.slots[device->frameIndex];
+	vkCmdEndQuery(commandBuffer, slot.stats, slot.count);
+	vkCmdWriteTimestamp(commandBuffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, slot.times, slot.count + 1);
+	slot.tags.push_back(state.tag);
+	slot.count++;
+}
+
+// ArmAgedon: ARMA_PIPELINE_STATS=1: every new pipeline's compiler statistics per stage (VK_KHR_pipeline_executable_properties),
+// one [pipe-stats] line each, with the draw tag current when the pipeline was created (the draw that needed it; the
+// renderer logs the tag names, ARMA_GPU_DRAW_PROFILE=1).
+static bool MGVK_PipelineStatsRequested()
+{
+	static int on = -1;
+	if (on < 0)
+	{
+		const char* v = getenv("ARMA_PIPELINE_STATS");
+		on = v != nullptr && v[0] == '1' ? 1 : 0;
+	}
+	return on == 1;
+}
+
+static void MGVK_PrintPipelineStats(MGG_GraphicsDevice* device, VkPipeline pipeline, uint32_t hash)
+{
+	if (vkGetPipelineExecutablePropertiesKHR == nullptr || vkGetPipelineExecutableStatisticsKHR == nullptr)
+		return;
+	auto it = s_drawProfiles.find(device);
+	int tag = it != s_drawProfiles.end() ? it->second.tag : -1;
+	VkPipelineInfoKHR info = { VK_STRUCTURE_TYPE_PIPELINE_INFO_KHR };
+	info.pipeline = pipeline;
+	uint32_t count = 0;
+	if (vkGetPipelineExecutablePropertiesKHR(device->device, &info, &count, nullptr) != VK_SUCCESS || count == 0)
+		return;
+	std::vector<VkPipelineExecutablePropertiesKHR> props(count, { VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_PROPERTIES_KHR });
+	vkGetPipelineExecutablePropertiesKHR(device->device, &info, &count, props.data());
+	for (uint32_t e = 0; e < count; e++)
+	{
+		VkPipelineExecutableInfoKHR exec = { VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_INFO_KHR };
+		exec.pipeline = pipeline;
+		exec.executableIndex = e;
+		uint32_t n = 0;
+		if (vkGetPipelineExecutableStatisticsKHR(device->device, &exec, &n, nullptr) != VK_SUCCESS || n == 0)
+			continue;
+		std::vector<VkPipelineExecutableStatisticKHR> stats(n, { VK_STRUCTURE_TYPE_PIPELINE_EXECUTABLE_STATISTIC_KHR });
+		vkGetPipelineExecutableStatisticsKHR(device->device, &exec, &n, stats.data());
+		std::string line = "[pipe-stats] tag=" + std::to_string(tag) + " pipeline=" + std::to_string(hash) + " stage=" + props[e].name + ":";
+		for (auto& st : stats)
+		{
+			line += " ";
+			line += st.name;
+			line += "=";
+			switch (st.format)
+			{
+			case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_BOOL32_KHR: line += st.value.b32 ? "1" : "0"; break;
+			case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_INT64_KHR: line += std::to_string(st.value.i64); break;
+			case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_UINT64_KHR: line += std::to_string(st.value.u64); break;
+			case VK_PIPELINE_EXECUTABLE_STATISTIC_FORMAT_FLOAT64_KHR: line += std::to_string(st.value.f64); break;
+			default: line += "?"; break;
+			}
+			line += ";";
+		}
+		printf("%s\n", line.c_str());
+	}
+	fflush(stdout);
+}
+
+/// The tag the next draws are recorded with (ARMA_GPU_DRAW_PROFILE); the renderer maps it to its name.
+MG_EXPORT void MGVK_SetDrawTag(MGG_GraphicsDevice* device, mgint tag)
+{
+	if (MGVK_DrawProfileRequested())
+		s_drawProfiles[device].tag = tag;
+}
+
+/// The draws profiled so far in the frame being recorded (the renderer's section boundaries).
+MG_EXPORT mgint MGVK_DrawProfileCount(MGG_GraphicsDevice* device)
+{
+	auto it = s_drawProfiles.find(device);
+	if (it == s_drawProfiles.end() || device->frameIndex >= it->second.slots.size())
+		return 0;
+	auto& slot = it->second.slots[device->frameIndex];
+	return slot.frame == device->frame ? (mgint)slot.count : 0;
+}
+
+/// The last frame whose profile came back (each once): its draw count (up to max), the frame it was recorded in, each
+/// draw's tag, its three statistics (vertex shader invocations, clipped primitives, fragment shader invocations) and
+/// count + 1 timestamps (times[0]: the frame's start; times must hold max + 1), and the nanoseconds per timestamp tick.
+MG_EXPORT mgint MGVK_ReadDrawProfile(MGG_GraphicsDevice* device, uint64_t* frame, int32_t* tags, uint64_t* stats,
+	uint64_t* times, mgint max, float* nsPerTick)
+{
+	*nsPerTick = device->deviceProperties.limits.timestampPeriod;
+	auto it = s_drawProfiles.find(device);
+	if (it == s_drawProfiles.end() || it->second.lastTags.empty())
+		return 0;
+	auto& state = it->second;
+	mgint count = (mgint)std::min<size_t>((size_t)max, state.lastTags.size());
+	for (mgint i = 0; i < count; i++)
+	{
+		tags[i] = state.lastTags[i];
+		stats[i * 3] = state.lastStats[(size_t)i * 3];
+		stats[i * 3 + 1] = state.lastStats[(size_t)i * 3 + 1];
+		stats[i * 3 + 2] = state.lastStats[(size_t)i * 3 + 2];
+	}
+	for (mgint i = 0; i <= count; i++)
+		times[i] = state.lastTimes[i];
+	*frame = state.lastFrame;
+	state.lastTags.clear();
+	return count;
+}
+
+/// The frame being recorded (MGVK_ReadTimestamps reports which frame its values are from).
+MG_EXPORT uint64_t MGVK_CurrentFrame(MGG_GraphicsDevice* device)
+{
+	assert(device != nullptr);
+	return device->frame;
+}
+
+/// The timestamps of the last frame whose results came back (each once): how many were copied into values (up to max),
+/// the frame they were written in, and the nanoseconds per timestamp tick.
+MG_EXPORT mgint MGVK_ReadTimestamps(MGG_GraphicsDevice* device, uint64_t* frame, uint64_t* values, mgint max, float* nsPerTick)
+{
+	assert(device != nullptr);
+	*nsPerTick = device->deviceProperties.limits.timestampPeriod;
+	auto it = s_timestamps.find(device);
+	if (it == s_timestamps.end())
+		return 0;
+	auto& state = it->second;
+	mgint count = (mgint)std::min<size_t>((size_t)max, state.last.size());
+	for (mgint i = 0; i < count; i++)
+		values[i] = state.last[i];
+	*frame = state.lastFrame;
+	state.last.clear();
+	return count;
+}
+
+// ArmAgedon: the runtime's own per-draw work (see MGVK_Perf), read and reset by the renderer's [perf] line: `seconds` gets
+// the four times (the descriptor update, its fill, its constant buffer copies, the pipeline binds) and `counters` the
+// counts, both in the order of MGVK_Perf's fields. Returns their number, 0 when ARMA_VK_PERF is off.
+// ArmAgedon: where the runtime's GPU memory goes (the renderer's [gpu-res] line): VMA's device memory blocks and the
+// allocations in them (a block is allocated whole, so blocks - allocations is reserved and unused), the frames' uniform
+// rings, and VMA's view of the heaps (usage and budget, summed over the device-local heaps). values: block bytes, block
+// count, allocation bytes, allocation count, uniform ring bytes, uniform ring count, heap usage, heap budget, buffer pool
+// page bytes, page count, the bytes of the ranges in them, range count. Returns how many it wrote.
+MG_EXPORT uint64_t MGVK_TextureDepthBytes(MGG_Texture* texture)
+{
+	if (texture == nullptr || texture->depthTexture == nullptr) return 0;
+	auto* depth = texture->depthTexture;
+	uint64_t bytes = depth->info.format == VK_FORMAT_D32_SFLOAT_S8_UINT ? 8 : depth->info.format == VK_FORMAT_D16_UNORM ? 2 : 4;
+	return bytes * depth->info.extent.width * depth->info.extent.height * depth->info.arrayLayers * (uint64_t)depth->info.samples;
+}
+
+MG_EXPORT mgint MGVK_ReadMemory(MGG_GraphicsDevice* device, uint64_t* values, mgint count)
+{
+	if (device == nullptr || device->allocator == VK_NULL_HANDLE || values == nullptr)
+		return 0;
+	VmaTotalStatistics stats;
+	vmaCalculateStatistics(device->allocator, &stats);
+	uint64_t ringBytes = 0, rings = 0;
+	for (auto& frame : device->frames)
+		for (auto* ring : frame.uniformChain)
+		{
+			ringBytes += (uint64_t)ring->dataSize;
+			rings++;
+		}
+	const VkPhysicalDeviceMemoryProperties* props = nullptr;
+	vmaGetMemoryProperties(device->allocator, &props);
+	VmaBudget budgets[VK_MAX_MEMORY_HEAPS];
+	vmaGetHeapBudgets(device->allocator, budgets);
+	uint64_t usage = 0, budget = 0;
+	for (uint32_t h = 0; props != nullptr && h < props->memoryHeapCount; h++)
+		if (props->memoryHeaps[h].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)
+		{
+			usage += budgets[h].usage;
+			budget += budgets[h].budget;
+		}
+	uint64_t poolUsed = 0, poolRanges = 0;
+	for (auto* page : device->bufferPages)
+	{
+		poolUsed += page->used;
+		poolRanges += page->ranges;
+	}
+	const uint64_t all[] = {
+		stats.total.statistics.blockBytes, stats.total.statistics.blockCount,
+		stats.total.statistics.allocationBytes, stats.total.statistics.allocationCount,
+		ringBytes, rings, usage, budget,
+		(uint64_t)device->bufferPages.size() * MGVK_POOL_PAGE_BYTES, (uint64_t)device->bufferPages.size(), poolUsed, poolRanges,
+	};
+	mgint n = (mgint)std::min<size_t>((size_t)count, sizeof(all) / sizeof(all[0]));
+	for (mgint i = 0; i < n; i++)
+		values[i] = all[i];
+	return n;
+}
+
+MG_EXPORT mgint MGVK_ReadPerf(double* seconds, uint64_t* counters, mgint maxCounters)
+{
+	if (!g_mgvkPerf.enabled)
+		return 0;
+	if (seconds != nullptr)
+	{
+		seconds[0] = g_mgvkPerf.tSets;
+		seconds[1] = g_mgvkPerf.tSetFills;
+		seconds[2] = g_mgvkPerf.tUbCopies;
+		seconds[3] = g_mgvkPerf.tPipeline;
+		seconds[4] = g_mgvkPerf.tDraw;
+		seconds[5] = g_mgvkPerf.tDriver;
+		seconds[6] = g_mgvkPerf.tRenderPass;
+		seconds[7] = g_mgvkPerf.tBufferSet;
+		seconds[8] = g_mgvkPerf.tBindSets;
+		seconds[9] = g_mgvkPerf.tBindVertex;
+		seconds[10] = g_mgvkPerf.tBindIndex;
+		seconds[11] = g_mgvkPerf.tDrawCmd;
+		seconds[12] = g_mgvkPerf.tDrawCmdAfterBind;
+	}
+	const uint64_t values[] = {
+		g_mgvkPerf.sets, g_mgvkPerf.setFills, g_mgvkPerf.setWrites, g_mgvkPerf.setAllocs,
+		g_mgvkPerf.ubCopies, g_mgvkPerf.ubBytes, g_mgvkPerf.pipelineBinds, g_mgvkPerf.passes,
+		g_mgvkPerf.textureSets, g_mgvkPerf.bufferSets, g_mgvkPerf.bufferBytes, g_mgvkPerf.draws,
+		g_mgvkPerf.indexBinds, g_mgvkPerf.indexRebinds, g_mgvkPerf.vertexBinds, g_mgvkPerf.setBinds,
+		g_mgvkPerf.drawsAfterBind,
+		// ArmAgedon: appended (the managed side reads by index, up to its own count): buffer writes by kind
+		g_mgvkPerf.constSets, g_mgvkPerf.constBytes, g_mgvkPerf.vtxDynSets, g_mgvkPerf.vtxDynBytes,
+		g_mgvkPerf.idxDynSets, g_mgvkPerf.idxDynBytes, g_mgvkPerf.vtxStaticSets, g_mgvkPerf.vtxStaticBytes,
+		g_mgvkPerf.idxStaticSets, g_mgvkPerf.idxStaticBytes, g_mgvkPerf.bufferDiscards,
+		g_mgvkPerf.pushUnchanged, g_mgvkPerf.pushUnchangedBytes, g_mgvkPerf.texUploads, g_mgvkPerf.texUploadBytes,
+	};
+	mgint count = (mgint)std::min<size_t>((size_t)maxCounters, sizeof(values) / sizeof(values[0]));
+	for (mgint i = 0; i < count; i++)
+		counters[i] = values[i];
+	MGVK_Perf fresh; // counted again from now on
+	fresh.enabled = true;
+	g_mgvkPerf = fresh;
+	return count;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// ArmAgedon: asynchronous texture readback. MGG_Texture_GetData submits its copy and waits for it, and so for all the GPU
+// work queued before it (a reflection-probe capture read back the frame after it was drawn waited ~24 ms on an Adreno 8cx
+// Gen 3). MGVK_ReadbackBegin records the same copy into a staging buffer and submits it with a fence; MGVK_ReadbackEnd
+// copies the data out once that fence has signaled. Patch kept in ArmAgedon/MonoGameRuntime/.
+// ---------------------------------------------------------------------------------------------------------------------
+
+struct MGVK_Readback
+{
+	MGG_Buffer buffer;
+	VkCommandBuffer commandBuffer = VK_NULL_HANDLE;
+	VkFence fence = VK_NULL_HANDLE;
+	mgint dataBytes = 0;
+};
+
+/// Starts copying a region of the texture into a staging buffer (MGG_Texture_GetData's arguments): the readback to pass to
+/// MGVK_ReadbackEnd. A target drawn into in the frame being recorded has that frame's commands submitted first, as
+/// MGG_Texture_GetData does.
+MG_EXPORT void* MGVK_ReadbackBegin(MGG_GraphicsDevice* device, MGG_Texture* texture, mgint level, mgint slice, mgint x, mgint y, mgint z, mgint width, mgint height, mgint depth, mgint dataBytes)
+{
+	assert(device != nullptr);
+	assert(texture != nullptr);
+	assert(dataBytes > 0);
+
+	MGVK_ClampAndValidateTextureRegion(texture, level, slice, x, y, z, width, height, depth);
+
+	std::lock_guard lock(device->transferMutex);
+	MGVK_WaitPendingTransfers(device, texture);
+
+	std::lock_guard lock2(device->queueMutex);
+
+	auto& frame = device->frames[device->frameIndex];
+	bool restart_frame = false;
+	if (frame.is_recording && (texture->writeFrame == device->frame || (texture->isTarget && texture->frame == device->frame))) // ArmAgedon memory: include copies into ordinary textures
+	{
+		MGVK_FlushCommands(device, frame);
+		restart_frame = true;
+	}
+
+	auto readback = new MGVK_Readback();
+	readback->dataBytes = dataBytes;
+	MGVK_BufferCreate(device, dataBytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT, VMA_MEMORY_USAGE_CPU_ONLY, &readback->buffer);
+	VK_SET_OBJECT_NAME(device->device, readback->buffer.buffer, VK_OBJECT_TYPE_BUFFER, "MGVK_ReadbackBegin::stagingBuffer");
+
+	VkImageLayout originalLayout = texture->layouts[level];
+	VkImageAspectFlags aspectMask = DetermineAspectMask(texture->info.format);
+
+	VkCommandBuffer copyCmd = MGVK_BeginNewCommandBuffer(device, device->transferPool);
+	MGVK_CmdTransitionImageLayout(copyCmd, texture->image, originalLayout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, aspectMask, level, 1, slice, 1);
+	MGVK_CmdCopyImageToBuffer(copyCmd, texture->image, readback->buffer.buffer, x, y, z, level, slice, width, height, depth, aspectMask);
+	MGVK_CmdTransitionImageLayout(copyCmd, texture->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, originalLayout, aspectMask, level, 1, slice, 1);
+	vkEndCommandBuffer(copyCmd);
+	readback->commandBuffer = copyCmd;
+
+	VkFenceCreateInfo fenceInfo = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+	VK_CHECK_RESULT(vkCreateFence(device->device, &fenceInfo, nullptr, &readback->fence));
+	VK_SET_OBJECT_NAME(device->device, readback->fence, VK_OBJECT_TYPE_FENCE, "MGVK_ReadbackBegin.fence");
+
+	VkSubmitInfo submitInfo = { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+	submitInfo.commandBufferCount = 1;
+	submitInfo.pCommandBuffers = &copyCmd;
+	VK_CHECK_RESULT(vkQueueSubmit(device->queue, 1, &submitInfo, readback->fence));
+
+	if (restart_frame)
+		MGVK_BeginCommandBuffer(frame.commandBuffer);
+
+	return readback;
+}
+
+/// 1 when the copy has finished: up to dataBytes of it copied into data (none when data is null) and the readback freed.
+/// 0 while it has not finished and wait is 0 (call again later); wait != 0 waits for it.
+MG_EXPORT mgint MGVK_ReadbackEnd(MGG_GraphicsDevice* device, void* handle, mgbyte* data, mgint dataBytes, mgint wait)
+{
+	assert(device != nullptr);
+	assert(handle != nullptr);
+
+	auto readback = (MGVK_Readback*)handle;
+	if (wait)
+		vkWaitForFences(device->device, 1, &readback->fence, VK_TRUE, UINT64_MAX);
+	else if (vkGetFenceStatus(device->device, readback->fence) != VK_SUCCESS)
+		return 0;
+
+	if (data != nullptr)
+	{
+		void* src;
+		vmaMapMemory(device->allocator, readback->buffer.allocation, &src);
+		memcpy(data, src, std::min(dataBytes, readback->dataBytes));
+		vmaUnmapMemory(device->allocator, readback->buffer.allocation);
+	}
+
+	vkDestroyFence(device->device, readback->fence, nullptr);
+	{
+		std::lock_guard lock(device->transferMutex);
+		vkFreeCommandBuffers(device->device, device->transferPool, 1, &readback->commandBuffer);
 	}
+	vmaDestroyBuffer(device->allocator, readback->buffer.buffer, readback->buffer.allocation);
+	delete readback;
+	return 1;
+}
+
+// ArmAgedon: seconds since the last read on this thread, plus actual Present count.
+// 8 is inclusive next-frame preparation; 9/10 are its fence/acquisition children.
+MG_EXPORT mgint MGVK_ReadPresentTiming(double* seconds, uint64_t* frames, mgint count)
+{
+    if (!armaPresentEnabled || !seconds || !frames || count < 14) return 0;
+    for (int i = 0; i < 11; ++i) seconds[i] = armaPresent.seconds[i];
+    seconds[11] = seconds[8] - seconds[9] - seconds[10];
+    seconds[12] = seconds[0];
+    for (int i = 1; i <= 8; ++i) seconds[12] -= seconds[i];
+    seconds[13] = armaPresent.maximum;
+    *frames = armaPresent.frames;
+    armaPresent = {};
+    return 14;
 }
