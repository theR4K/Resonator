+// ArmAgedon vk-fdm: distinct export preserves the old copy ABI when deploying against an older native runtime.
+MG_EXPORT mgint MGVK_RecordCopyToExternalImageLayer(MGG_GraphicsDevice* device, MGG_Texture* source, uint64_t externalImage, mgint externalFormat, mgint width, mgint height, mgbool flipY, mgint dstLayer)
+{
