+struct ArmaPresentSpan
+{
+    int index;
+    bool active;
+    ArmaPresentClock::time_point begin;
+    ArmaPresentSpan(int i, bool record = true) : index(i), active(armaPresentEnabled && record)
+    { if (active) begin = ArmaPresentClock::now(); }
+    void Stop()
+    {
+        if (!active) return;
+        armaPresent.seconds[index] += std::chrono::duration<double>(ArmaPresentClock::now() - begin).count();
+        active = false;
+    }
+    ~ArmaPresentSpan() { Stop(); }
+};
+struct ArmaPresentTotal
+{
+    ArmaPresentClock::time_point begin;
+    ArmaPresentTotal() { if (armaPresentEnabled) begin = ArmaPresentClock::now(); }
+    ~ArmaPresentTotal()
