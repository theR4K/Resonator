+// ---------------------------------------------------------------------------------------------------------------------
+// ArmAgedon: GPU timestamps for frame timings. Off until MGVK_WriteTimestamp is first called. Each frame in flight has a
+// query pool, reset when that frame begins recording; the results of the frame that used it before are copied out first
+// (its fence was waited for by then) and read with MGVK_ReadTimestamps. Patch kept in ArmAgedon/MonoGameRuntime/.
+// ---------------------------------------------------------------------------------------------------------------------
+
+#include <unordered_map>
+
+static const uint32_t MGVK_MAX_TIMESTAMPS = 128;
+
+struct MGVK_TimestampSlot
+{
+	VkQueryPool pool = VK_NULL_HANDLE;
+	uint32_t count = 0;
+	FrameCounter frame = 0;
+};
+
+struct MGVK_TimestampState
+{
+	bool enabled = false;
+	std::vector<MGVK_TimestampSlot> slots;
+	std::vector<uint64_t> last;
+	FrameCounter lastFrame = 0;
+};
+
+static std::unordered_map<MGG_GraphicsDevice*, MGVK_TimestampState> s_timestamps;
+
+static void MGVK_TimestampsBeginFrame(MGG_GraphicsDevice* device, VkCommandBuffer commandBuffer)
+{
+	auto it = s_timestamps.find(device);
+	if (it == s_timestamps.end() || !it->second.enabled)
+		return;
+	auto& state = it->second;
+	if (state.slots.size() < device->swapchainCount)
+		state.slots.resize(device->swapchainCount);
+	auto& slot = state.slots[device->frameIndex];
+	if (slot.pool == VK_NULL_HANDLE)
+	{
+		VkQueryPoolCreateInfo createInfo = { VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO };
+		createInfo.queryType = VK_QUERY_TYPE_TIMESTAMP;
+		createInfo.queryCount = MGVK_MAX_TIMESTAMPS;
+		if (vkCreateQueryPool(device->device, &createInfo, nullptr, &slot.pool) != VK_SUCCESS)
+		{
+			slot.pool = VK_NULL_HANDLE;
+			state.enabled = false;
+			return;
+		}
+	}
+	else if (slot.count > 0)
+	{
+		state.last.assign(slot.count, 0);
+		VkResult res = vkGetQueryPoolResults(device->device, slot.pool, 0, slot.count, sizeof(uint64_t) * slot.count,
+			state.last.data(), sizeof(uint64_t), VK_QUERY_RESULT_64_BIT);
+		if (res == VK_SUCCESS)
+			state.lastFrame = slot.frame;
+		else
+			state.last.clear();
+	}
+	vkCmdResetQueryPool(commandBuffer, slot.pool, 0, MGVK_MAX_TIMESTAMPS);
+	slot.count = 0;
+	slot.frame = device->frame;
+}
+
+/// Writes a GPU timestamp after the commands recorded so far; its index in this frame, or -1 (timestamps start with the
+/// frame after the first call, or the device has none).
+MG_EXPORT mgint MGVK_WriteTimestamp(MGG_GraphicsDevice* device)
+{
+	assert(device != nullptr);
+	if (!device->deviceProperties.limits.timestampComputeAndGraphics)
+		return -1;
+	auto& state = s_timestamps[device];
+	if (!state.enabled)
+	{
+		state.enabled = true;
+		return -1;
+	}
+	if (device->frameIndex >= state.slots.size())
+		return -1;
+	auto& slot = state.slots[device->frameIndex];
+	auto& frame = device->frames[device->frameIndex];
+	if (slot.pool == VK_NULL_HANDLE || slot.frame != device->frame || slot.count >= MGVK_MAX_TIMESTAMPS || !frame.is_recording)
+		return -1;
+	vkCmdWriteTimestamp(frame.commandBuffer, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, slot.pool, slot.count);
+	return (mgint)slot.count++;
+}
+
+/// The frame being recorded (MGVK_ReadTimestamps reports which frame its values are from).
+MG_EXPORT uint64_t MGVK_CurrentFrame(MGG_GraphicsDevice* device)
+{
+	assert(device != nullptr);
+	return device->frame;
+}
+
+/// The timestamps of the last frame whose results came back (each once): how many were copied into values (up to max),
+/// the frame they were written in, and the nanoseconds per timestamp tick.
+MG_EXPORT mgint MGVK_ReadTimestamps(MGG_GraphicsDevice* device, uint64_t* frame, uint64_t* values, mgint max, float* nsPerTick)
+{
+	assert(device != nullptr);
+	*nsPerTick = device->deviceProperties.limits.timestampPeriod;
+	auto it = s_timestamps.find(device);
+	if (it == s_timestamps.end())
+		return 0;
+	auto& state = it->second;
+	mgint count = (mgint)std::min<size_t>((size_t)max, state.last.size());
+	for (mgint i = 0; i < count; i++)
+		values[i] = state.last[i];
+	*frame = state.lastFrame;
+	state.last.clear();
+	return count;
+}
