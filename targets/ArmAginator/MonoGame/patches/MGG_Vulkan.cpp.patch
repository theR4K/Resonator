+MG_EXPORT void MGVK_GetExternalHandles(MGG_GraphicsDevice* device, MGVK_ExternalHandles* handles)
+{
+	assert(device != nullptr);
+	assert(handles != nullptr);
+	handles->instance = device->instance;
+	handles->physicalDevice = device->physicalDevice;
+	handles->device = device->device;
+	handles->queueFamilyIndex = device->graphicsQueueFamily;
+	handles->queueIndex = 0;
+	handles->queue = device->queue;
