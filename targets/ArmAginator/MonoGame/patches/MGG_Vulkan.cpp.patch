+
+/// Space-separated extension lists to enable in addition to MonoGame's own. Must be called before the
+/// GraphicsSystem (instance) and GraphicsDevice are created, i.e. before the Game object exists.
+MG_EXPORT void MGVK_SetExtraExtensions(const char* instanceExtensions, const char* deviceExtensions)
+{
+	MGVK_SplitNames(instanceExtensions, s_extraInstanceExtensions);
+	MGVK_SplitNames(deviceExtensions, s_extraDeviceExtensions);
+}
+
+// ArmAgedon: graphics-thread diagnostics for resize regression checks; no GPU work.
+MG_EXPORT mgint MGVK_GetBackbufferState(MGG_GraphicsDevice* device, mgint* values, mgint count)
+{
+    if (device == nullptr || values == nullptr || count < 6) return 0;
+    values[0] = (mgint)device->swapchainWidth;
+    values[1] = (mgint)device->swapchainHeight;
+    values[2] = (mgint)device->viewport.width;
+    values[3] = (mgint)device->viewport.height;
+    values[4] = (mgint)device->scissor.extent.width;
+    values[5] = (mgint)device->scissor.extent.height;
+    return 6;
+}
+
+MG_EXPORT void MGVK_GetExternalHandles(MGG_GraphicsDevice* device, MGVK_ExternalHandles* handles)
+{
+	assert(device != nullptr);
+	assert(handles != nullptr);
+	handles->instance = device->instance;
+	handles->physicalDevice = device->physicalDevice;
+	handles->device = device->device;
+	handles->queueFamilyIndex = device->graphicsQueueFamily;
+	handles->queueIndex = 0;
+	handles->queue = device->queue;
+}
