+static const bool armaPresentEnabled = [] {
+    const char* value = std::getenv("ARMA_VK_PRESENT_TIMING");
+    return value && value[0] == '1' && value[1] == '\0';
+}();
+struct ArmaPresentData
+{
+    double seconds[11] = {};
+    uint64_t frames = 0;
+    double maximum = 0;
+    bool nextPrepare = false;
