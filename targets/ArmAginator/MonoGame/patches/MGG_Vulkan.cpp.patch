+// ArmAgedon: a new texture's first layout transition, submitted without waiting for it. The stock code waited on a fence,
+// and so on every frame in flight queued before it: ~7 ms per new render target, and a stall per texture while a world
+// loads. Tracked like a SetData transfer (its command buffer and fence freed when done, MGVK_WaitPendingTransfers for the
+// texture still waits for it); the next submit of the frame's command buffer waits on its semaphore (MGVK_WaitCreations),
+// so nothing drawn reaches the image before its transition, whatever stages the later barriers name. Under transferMutex.
+static void MGVK_SubmitCreation(MGG_GraphicsDevice* device, MGG_Texture* owner, VkCommandBuffer commandBuffer)
+{
+	vkEndCommandBuffer(commandBuffer);
+
+	MGVK_Transfer transfer = {};
+	transfer.owner = owner;
+	transfer.cmd = commandBuffer;
+	VkFenceCreateInfo fenceInfo = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+	vkCreateFence(device->device, &fenceInfo, nullptr, &transfer.done);
+	VK_SET_OBJECT_NAME(device->device, transfer.done, VK_OBJECT_TYPE_FENCE, "MGVK_SubmitCreation.done");
+
+	VkSemaphore created;
+	VkSemaphoreCreateInfo semaphoreInfo = { VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+	vkCreateSemaphore(device->device, &semaphoreInfo, nullptr, &created);
+
+	std::lock_guard lock(device->queueMutex);
+	VkSubmitInfo submit = { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+	submit.commandBufferCount = 1;
+	submit.pCommandBuffers = &commandBuffer;
+	submit.signalSemaphoreCount = 1;
+	submit.pSignalSemaphores = &created;
+	vkQueueSubmit(device->queue, 1, &submit, transfer.done);
+
+	device->pendingTransfers.push_back(transfer);
+	device->pendingCreates.push_back(created);
+}
+
+// ArmAgedon: a submit of the frame's command buffer waits on the creation transitions not waited on yet. Under queueMutex.
+static void MGVK_WaitCreations(MGG_GraphicsDevice* device, MGVK_Frame& frame, std::vector<VkSemaphore>& waits, std::vector<VkPipelineStageFlags>& stages)
+{
+	for (VkSemaphore s : device->pendingCreates)
+	{
+		waits.push_back(s);
+		stages.push_back(VK_PIPELINE_STAGE_ALL_COMMANDS_BIT);
+		frame.waitedCreates.push_back(s);
+	}
+	device->pendingCreates.clear();
 }
 
