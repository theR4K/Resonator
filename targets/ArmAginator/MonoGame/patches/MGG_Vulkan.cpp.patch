+MG_EXPORT void MGVK_SetTextureLayout(MGG_GraphicsDevice* device, MGG_Texture* texture, mgint layout)
+{
+	if (device == nullptr || texture == nullptr)
+		return;
+	for (int i = 0; i < MGVK_MAX_MIPS; i++)
+		texture->layouts[i] = (VkImageLayout)layout;
+	texture->frame = device->frame;
