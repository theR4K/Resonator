+        if (!armaPresentEnabled) return;
+        double seconds = std::chrono::duration<double>(ArmaPresentClock::now() - begin).count();
+        armaPresent.seconds[0] += seconds;
+        armaPresent.maximum = std::max(armaPresent.maximum, seconds);
+        ++armaPresent.frames;
+    }
+};
