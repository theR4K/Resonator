+// ---------------------------------------------------------------------------------------------------------------------
+// ArmAgedon: video interop. mpv (libplacebo, FFmpeg Vulkan Video) shares this VkDevice and renders video frames into render
+// targets on its own threads. Queue access goes through the lock callbacks; frames are handed over with timeline
+// semaphores: mpv waits on the frame timeline before writing a target (MGVK_FrameTimelineValue), the frame waits on mpv's
+// semaphore before sampling it (MGVK_AddFrameWait). Nothing changes unless MGVK_RequestVideoInterop was called.
+// ---------------------------------------------------------------------------------------------------------------------
+
+/// Before the Game exists (it creates the instance and device): ask for the device the interop needs.
+MG_EXPORT void MGVK_RequestVideoInterop(mgbool on)
+{
+	s_videoInteropRequested = on != 0;
+}
+
+struct MGVK_VideoInteropInfo
+{
+	void* instance;
+	void* getInstanceProcAddr;
+	uint32_t apiVersion;
+	const char* const* instanceExtensions;
+	int32_t numInstanceExtensions;
+	void* physicalDevice;
+	void* device;
+	const char* const* deviceExtensions;
+	int32_t numDeviceExtensions;
+	const void* features; // VkPhysicalDeviceFeatures2 chain, valid as long as the device
+	uint32_t queueFamily;
+	uint32_t queueCount;
+	void* lockQueue;   // void(void* ctx, uint32_t family, uint32_t index)
+	void* unlockQueue;
+	void* queueContext;
+	uint64_t frameTimeline; // VkSemaphore (timeline) signaled by the frame's submits
+};
+
+static void MGVK_InteropLockQueue(void* ctx, uint32_t family, uint32_t index)
+{
+	auto device = (MGG_GraphicsDevice*)ctx;
+	if (family == device->graphicsQueueFamily)
+		device->queueMutex.lock();
+	else
+		device->videoQueueMutex.lock();
+}
+
+static void MGVK_InteropUnlockQueue(void* ctx, uint32_t family, uint32_t index)
+{
+	auto device = (MGG_GraphicsDevice*)ctx;
+	if (family == device->graphicsQueueFamily)
+		device->queueMutex.unlock();
+	else
+		device->videoQueueMutex.unlock();
+}
+
+/// Returns 0 and fills info when the device was created for the interop, -1 otherwise.
+MG_EXPORT mgint MGVK_GetVideoInterop(MGG_GraphicsDevice* device, MGVK_VideoInteropInfo* info)
+{
+	if (device == nullptr || info == nullptr || device->video == nullptr || device->frameTimeline == VK_NULL_HANDLE)
+		return -1;
+	MGVK_VideoInterop* video = device->video;
+	info->instance = device->instance;
+	info->getInstanceProcAddr = (void*)vkGetInstanceProcAddr;
+	info->apiVersion = s_instanceApiVersion;
+	info->instanceExtensions = video->instanceExtensionNames.data();
+	info->numInstanceExtensions = (int32_t)video->instanceExtensionNames.size();
+	info->physicalDevice = device->physicalDevice;
+	info->device = device->device;
+	info->deviceExtensions = video->deviceExtensionNames.data();
+	info->numDeviceExtensions = (int32_t)video->deviceExtensionNames.size();
+	info->features = &video->features;
+	info->queueFamily = device->graphicsQueueFamily;
+	info->queueCount = 1;
+	info->lockQueue = (void*)&MGVK_InteropLockQueue;
+	info->unlockQueue = (void*)&MGVK_InteropUnlockQueue;
+	info->queueContext = device;
+	info->frameTimeline = (uint64_t)device->frameTimeline;
+	return 0;
+}
