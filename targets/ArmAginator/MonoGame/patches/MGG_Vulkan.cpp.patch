+/// Space-separated extension lists to enable in addition to MonoGame's own. Must be called before the
+/// GraphicsSystem (instance) and GraphicsDevice are created, i.e. before the Game object exists.
+MG_EXPORT void MGVK_SetExtraExtensions(const char* instanceExtensions, const char* deviceExtensions)
+{
+	MGVK_SplitNames(instanceExtensions, s_extraInstanceExtensions);
+	MGVK_SplitNames(deviceExtensions, s_extraDeviceExtensions);
+}
