+/// The next submit of the frame's command buffer waits until the timeline semaphore reaches value (all stages).
+MG_EXPORT void MGVK_AddFrameWait(MGG_GraphicsDevice* device, uint64_t semaphore, uint64_t value)
+{
+	if (device == nullptr || semaphore == 0 || device->frameTimeline == VK_NULL_HANDLE)
+		return;
+	std::lock_guard lock(device->queueMutex);
+	device->pendingExternalWaits.emplace_back((VkSemaphore)semaphore, value);
+}
+
+/// The frame timeline value the latest submit of a frame's command buffer signals: once it is reached, everything submitted
+/// so far by MonoGame's frames is done.
+MG_EXPORT uint64_t MGVK_FrameTimelineValue(MGG_GraphicsDevice* device)
+{
+	if (device == nullptr)
+		return 0;
+	std::lock_guard lock(device->queueMutex);
+	return device->frameTimelineValue;
+}
