+/// The VkImage behind a texture/render target (+ its VkFormat and size).
+MG_EXPORT uint64_t MGVK_GetTextureImage(MGG_Texture* texture, mgint* vkFormat, mgint* width, mgint* height)
+{
+	assert(texture != nullptr);
+	if (vkFormat) *vkFormat = (mgint)texture->info.format;
+	if (width) *width = (mgint)texture->info.extent.width;
+	if (height) *height = (mgint)texture->info.extent.height;
+	return (uint64_t)texture->image;
+}
