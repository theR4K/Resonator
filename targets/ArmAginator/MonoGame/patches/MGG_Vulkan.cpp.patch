+		blit.dstOffsets[0] = { 0, flipY ? height : 0, 0 };
+		blit.dstOffsets[1] = { width, flipY ? 0 : height, 1 };
+		vkCmdBlitImage(cmd, src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_LINEAR);
+	}
+
+	barriers[0].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+	barriers[0].newLayout = srcLayout;
+	barriers[0].srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+	barriers[0].dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+	barriers[1].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barriers[1].newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+	barriers[1].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	barriers[1].dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+
+	MGVK_ExecuteAndFreeCommandBuffer(device, cmd, device->transferPool);
+	source->layouts[0] = srcLayout;
+
+	if (restart_frame)
+		MGVK_BeginCommandBuffer(frame.commandBuffer);
+	return 0;
+}
+
+/// ArmAgedon: whether frames acquire and present a window image. Off (XR with no desktop mirror): the window is neither
+/// acquired nor presented, which on a compositor such as gamescope saves the present and acquire calls' CPU time every
+/// frame; the frame's commands are still submitted at present with its fence. Takes effect with the next frame.
+MG_EXPORT void MGVK_SetWindowPresent(MGG_GraphicsDevice* device, mgbool enabled)
+{
+	assert(device != nullptr);
+	device->windowPresent = enabled != 0;
+}
+
+/// ArmAgedon: MGVK_CopyToExternalImage without its two waits: the copy is recorded into the frame's command buffer (the
+/// render pass in progress is ended; the next draw starts another), so it reaches the queue with the frame at present.
+/// OpenXR only needs the commands writing a swapchain image submitted before xrReleaseSwapchainImage, so the caller
+/// releases the image (and ends the XR frame) after present. Same layouts and copy/blit choice as the synchronous copy.
+static mgint MGVK_RecordCopyImpl(MGG_GraphicsDevice* device, MGG_Texture* source, uint64_t externalImage, mgint externalFormat, mgint width, mgint height, mgbool flipY, uint32_t layer,
+	VkImageLayout dstLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VkImageLayout dstOldLayout = VK_IMAGE_LAYOUT_MAX_ENUM, uint32_t dstLayer = 0) // ArmAgedon vk-fdm
+{
+	assert(device != nullptr);
+	if (source == nullptr || externalImage == 0 || source->image == VK_NULL_HANDLE || layer >= source->info.arrayLayers)
+		return -1;
+	auto& frame = device->frames[device->frameIndex];
+	if (!frame.is_recording)
+		return -2;
+	VkCommandBuffer cmd = frame.commandBuffer;
+	MGVK_EndRenderPass(device, cmd);
+
+	VkImage src = source->image;
+	VkImage dst = (VkImage)externalImage;
+	VkImageLayout srcLayout = source->layouts[0];
+	if (srcLayout == VK_IMAGE_LAYOUT_UNDEFINED)
+		srcLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+
+	VkImageMemoryBarrier barriers[2] = {};
+	for (auto& b : barriers)
+	{
+		b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+		b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+	}
+	barriers[0].image = src;
+	barriers[0].subresourceRange.baseArrayLayer = layer; // ArmAgedon vk-multiview: one view of a multiview target
+	barriers[0].oldLayout = srcLayout;
+	barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+	barriers[0].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+	barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+	barriers[1].image = dst;
+	barriers[1].oldLayout = dstOldLayout == VK_IMAGE_LAYOUT_MAX_ENUM ? dstLayout : dstOldLayout; // UNDEFINED: never used yet
+	barriers[1].subresourceRange.baseArrayLayer = dstLayer; // ArmAgedon vk-fdm: stereo swapchain destination layer
+	barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barriers[1].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+	barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT,
+		VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+
+	int32_t sw = (int32_t)source->info.extent.width, sh = (int32_t)source->info.extent.height;
+	bool rgba8Pair = (source->info.format == VK_FORMAT_R8G8B8A8_UNORM || source->info.format == VK_FORMAT_R8G8B8A8_SRGB)
+		&& (externalFormat == VK_FORMAT_R8G8B8A8_UNORM || externalFormat == VK_FORMAT_R8G8B8A8_SRGB);
+	if (!flipY && sw == width && sh == height && (rgba8Pair || (mgint)source->info.format == externalFormat))
+	{
+		VkImageCopy region = {};
+		region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, layer, 1 };
+		region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, dstLayer, 1 }; // ArmAgedon vk-fdm
+		region.extent = { (uint32_t)width, (uint32_t)height, 1 };
+		vkCmdCopyImage(cmd, src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	}
+	else
+	{
+		VkImageBlit blit = {};
+		blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, layer, 1 };
+		blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, dstLayer, 1 }; // ArmAgedon vk-fdm
+		blit.srcOffsets[0] = { 0, 0, 0 };
+		blit.srcOffsets[1] = { sw, sh, 1 };
+		blit.dstOffsets[0] = { 0, flipY ? height : 0, 0 };
+		blit.dstOffsets[1] = { width, flipY ? 0 : height, 1 };
+		vkCmdBlitImage(cmd, src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_LINEAR);
+	}
+
+	barriers[0].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+	barriers[0].newLayout = srcLayout;
+	barriers[0].srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+	barriers[0].dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+	barriers[1].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barriers[1].newLayout = dstLayout;
+	barriers[1].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	barriers[1].dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT,
+		VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT | VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+	source->layouts[0] = srcLayout;
+	return 0;
+}
+
+// ArmAgedon vk-fdm: stable, optional probe ABI for managed builds used with older native runtimes.
+MG_EXPORT uint64_t MGVK_CreateTestDensityMap(MGG_GraphicsDevice* device, mgint width, mgint height, mgint layers, mgint* mapWidth, mgint* mapHeight)
+{
+	if (device == nullptr || !device->fdmEnabled || width <= 0 || height <= 0 || layers < 1 || layers > 2 || mapWidth == nullptr || mapHeight == nullptr) return 0;
+	VkImageCreateInfo info = { VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO };
+	info.imageType = VK_IMAGE_TYPE_2D;
+	info.format = VK_FORMAT_R8G8_UNORM;
+	info.extent = { ((uint32_t)width + device->fdmProbe[3] - 1) / device->fdmProbe[3],
+		((uint32_t)height + device->fdmProbe[4] - 1) / device->fdmProbe[4], 1 };
+	info.mipLevels = 1; info.arrayLayers = layers;
+	// ArmAgedon gaze: the patterned test exercises real offset movement rather than only constant-density shading.
+	const char* patternEnv = std::getenv("ARMA_TEST_FDM_PATTERN");
+	const bool gazePattern = device->fdmOffset && patternEnv != nullptr && strcmp(patternEnv, "1") == 0;
+	if (gazePattern) info.flags |= VK_IMAGE_CREATE_FRAGMENT_DENSITY_MAP_OFFSET_BIT_QCOM;
+	info.samples = VK_SAMPLE_COUNT_1_BIT;
+	info.tiling = VK_IMAGE_TILING_OPTIMAL;
+	info.usage = VK_IMAGE_USAGE_FRAGMENT_DENSITY_MAP_BIT_EXT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+	VmaAllocationCreateInfo allocationInfo = {};
+	allocationInfo.usage = VMA_MEMORY_USAGE_CPU_TO_GPU; // ArmAgedon vk-fdm: Turnip reads static maps on the host
+	allocationInfo.flags = VMA_ALLOCATION_CREATE_DEDICATED_MEMORY_BIT | VMA_ALLOCATION_CREATE_MAPPED_BIT;
+	allocationInfo.requiredFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+	VkImage image; VmaAllocation allocation;
+	if (vmaCreateImage(device->allocator, &info, &allocationInfo, &image, &allocation, nullptr) != VK_SUCCESS) return 0;
+	VkCommandBuffer cmd = MGVK_BeginNewCommandBuffer(device, device->transferPool);
+	VkImageMemoryBarrier barrier = { VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER };
+	barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.image = image;
+	barrier.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, (uint32_t)layers };
+	barrier.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	barrier.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barrier.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+	VkClearColorValue value = { { 64.0f / 255.0f, 64.0f / 255.0f, 0.0f, 0.0f } };
+	if (!gazePattern) vkCmdClearColorImage(cmd, image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &value, 1, &barrier.subresourceRange);
+	if (gazePattern)
+	{
+		// A central full-density rectangle in both layers. Outside it remains quarter-density.
+		// The GPU clear uses the real optimal-image layout and avoids assumptions about CPU row/layer pitch.
+		// ClearColorImage cannot clear a rectangle; upload a tiny R8G8 map through a staging buffer below instead.
+		std::vector<uint8_t> pixels((size_t)info.extent.width * info.extent.height * layers * 2, 64);
+		for (int layer = 0; layer < layers; layer++)
+			for (uint32_t y = info.extent.height / 5; y < info.extent.height * 4 / 5; y++)
+				for (uint32_t x = info.extent.width / 5; x < info.extent.width * 4 / 5; x++)
+				{
+					size_t at = (((size_t)layer * info.extent.height + y) * info.extent.width + x) * 2;
+					pixels[at] = pixels[at + 1] = 255;
+				}
+		VkBufferCreateInfo stagingInfo = { VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO };
+		stagingInfo.size = pixels.size(); stagingInfo.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+		VmaAllocationCreateInfo stagingAlloc = {};
+		stagingAlloc.usage = VMA_MEMORY_USAGE_CPU_TO_GPU;
+		stagingAlloc.flags = VMA_ALLOCATION_CREATE_MAPPED_BIT;
+		VkBuffer staging; VmaAllocation stagingMemory; VmaAllocationInfo stagingMapped;
+		VK_CHECK_RESULT(vmaCreateBuffer(device->allocator, &stagingInfo, &stagingAlloc, &staging, &stagingMemory, &stagingMapped));
+		memcpy(stagingMapped.pMappedData, pixels.data(), pixels.size());
+		vmaFlushAllocation(device->allocator, stagingMemory, 0, pixels.size());
+		VkBufferImageCopy copy = {};
+		copy.imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, (uint32_t)layers };
+		copy.imageExtent = info.extent;
+		vkCmdCopyBufferToImage(cmd, staging, image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+		// The scratch upload must remain alive until its transfer completes.
+		barrier.oldLayout = barrier.newLayout;
+		barrier.newLayout = VK_IMAGE_LAYOUT_FRAGMENT_DENSITY_MAP_OPTIMAL_EXT;
+		barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+		barrier.dstAccessMask = VK_ACCESS_FRAGMENT_DENSITY_MAP_READ_BIT_EXT;
+		vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_DENSITY_PROCESS_BIT_EXT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+		MGVK_ExecuteAndFreeCommandBuffer(device, cmd, device->transferPool);
+		vmaDestroyBuffer(device->allocator, staging, stagingMemory);
+		device->fdmTestImages.push_back({ image, allocation });
+		*mapWidth = info.extent.width; *mapHeight = info.extent.height;
+		printf("[xr] foveation: centered gaze test pattern %ux%ux%d\n", info.extent.width, info.extent.height, layers);
+		return (uint64_t)image;
+	}
+	barrier.oldLayout = barrier.newLayout;
+	barrier.newLayout = VK_IMAGE_LAYOUT_FRAGMENT_DENSITY_MAP_OPTIMAL_EXT;
+	barrier.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	barrier.dstAccessMask = VK_ACCESS_FRAGMENT_DENSITY_MAP_READ_BIT_EXT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_FRAGMENT_DENSITY_PROCESS_BIT_EXT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+	MGVK_ExecuteAndFreeCommandBuffer(device, cmd, device->transferPool);
+	device->fdmTestImages.push_back({ image, allocation });
+	*mapWidth = info.extent.width; *mapHeight = info.extent.height;
+	printf("[xr] foveation: constant 0x40/0x40 test map %ux%ux%d\n", info.extent.width, info.extent.height, layers);
+	return (uint64_t)image;
+}
+
+MG_EXPORT mgint MGVK_SetTargetDensityMap(MGG_GraphicsDevice* device, MGG_Texture* target, uint64_t image, mgint format, mgint width, mgint height, mgint layers, mgint layer)
+{
+	if (device == nullptr || target == nullptr || !target->isTarget) return -1;
+	target->densityDebug[23]++;
+	MGVK_DensityMap density = {};
+	if (image != 0)
+	{
+		if (!device->fdmEnabled || format != VK_FORMAT_R8G8_UNORM || width <= 0 || height <= 0 || layers <= 0 || layer >= layers) return -2;
+		if (layer < 0 && (!device->fdmLayered || target->viewMask == 0 || layers < 2 || (uint32_t)layers > device->fdmProbe[9])) return -3;
+		// Density map dimensions are independent of framebuffer dimensions; check the spec's maximum texel size bound.
+		if ((uint32_t)width < (target->info.extent.width + device->fdmProbe[5] - 1) / device->fdmProbe[5] ||
+			(uint32_t)height < (target->info.extent.height + device->fdmProbe[6] - 1) / device->fdmProbe[6]) return -4;
+		density.image = (VkImage)image;
+		density.format = (VkFormat)format;
+		density.width = width; density.height = height;
+		density.layers = layer < 0 ? layers : 1;
+		density.baseLayer = layer < 0 ? 0 : layer;
+	}
+	if (memcmp(&target->density, &density, sizeof(density)) == 0) return 0;
+	target->density = density;
+	if (device->targets.targets[0] == target)
+	{
+		device->renderTargetDirty = true;
+		device->pipelineStateDirty = true;
+	}
+	return 0;
+}
+
+// ArmAgedon gaze: dynamic offsets are kept outside the framebuffer key and latched by each render-pass begin.
+MG_EXPORT mgint MGVK_SetTargetDensityGaze(MGG_GraphicsDevice* device, MGG_Texture* target,
+	float leftX, float leftY, float rightX, float rightY, mgint active)
+{
+	if (device == nullptr || target == nullptr || !target->isTarget) return -1;
+	target->densityDebug[24]++;
+	if (active && (!device->fdmOffset || !(target->info.flags & VK_IMAGE_CREATE_FRAGMENT_DENSITY_MAP_OFFSET_BIT_QCOM))) return -2;
+	if (!std::isfinite(leftX) || !std::isfinite(leftY) || !std::isfinite(rightX) || !std::isfinite(rightY)) return -3;
+	auto quantize = [](float ndc, uint32_t extent, uint32_t granularity) -> int32_t {
+		float step = (float)std::max(1u, granularity);
+		return (int32_t)(std::round(std::clamp(ndc, -1.0f, 1.0f) * (float)extent * 0.5f / step) * step);
+	};
+	VkOffset2D offsets[2] = {};
+	if (active)
+	{
+		// Frame META foveation centers use Vulkan NDC (+Y down), verified with the per-eye gaze HUD.
+		// Do not mirror Y again. Each eye has its own optical center.
+		offsets[0] = { quantize(leftX, target->info.extent.width, device->fdmOffsetGranularity.width),
+			quantize(leftY, target->info.extent.height, device->fdmOffsetGranularity.height) };
+		offsets[1] = { quantize(rightX, target->info.extent.width, device->fdmOffsetGranularity.width),
+			quantize(rightY, target->info.extent.height, device->fdmOffsetGranularity.height) };
+	}
+	if (target->densityOffsetActive == (active != 0) && memcmp(offsets, target->densityOffsets, sizeof(offsets)) == 0) return 0;
+	if (device->inRenderPass && device->targets.targets[0] == target)
+		MGVK_EndRenderPass(device, device->frames[device->frameIndex].commandBuffer);
+	memcpy(target->densityOffsets, offsets, sizeof(offsets));
+	target->densityOffsetActive = active != 0;
+	if (device->targets.targets[0] == target) device->renderTargetDirty = true;
+	return 0;
+}
+
+// ArmAgedon gaze overlay: read-only metadata from the exact target being drawn/submitted.
+MG_EXPORT mgint MGVK_ReadTargetDensityDebug(MGG_GraphicsDevice* device, MGG_Texture* target, mgint* values, mgint count)
+{
+	if (device == nullptr || target == nullptr || values == nullptr || count < 33) return 0;
+	auto debug = target->densityDebug;
+	debug[0] = 1; debug[1] = target->id; debug[2] = target->info.extent.width; debug[3] = target->info.extent.height;
+	debug[4] = target->density.baseLayer; debug[5] = target->density.layers; debug[6] = target->densityOffsetActive;
+	debug[7] = target->densityOffsets[0].x; debug[8] = target->densityOffsets[0].y;
+	debug[9] = target->densityOffsets[1].x; debug[10] = target->densityOffsets[1].y;
+	debug[28] = (target->info.flags & VK_IMAGE_CREATE_FRAGMENT_DENSITY_MAP_OFFSET_BIT_QCOM) != 0;
+	debug[29] = target->depthTexture != nullptr && (target->depthTexture->info.flags & VK_IMAGE_CREATE_FRAGMENT_DENSITY_MAP_OFFSET_BIT_QCOM) != 0;
+	debug[30] = device->fdmOffset; debug[31] = device->fdmOffsetGranularity.width; debug[32] = device->fdmOffsetGranularity.height;
+	memcpy(values, debug, 33 * sizeof(mgint));
+	return 33;
+}
+
+// ArmAgedon vk-fdm: finish graphics work and drop framebuffers before XR destroys its images; teardown only.
+MG_EXPORT void MGVK_ReleaseDensityMaps(MGG_GraphicsDevice* device, uint64_t* images, mgint count)
+{
+	if (device == nullptr || images == nullptr || count <= 0) return;
+	auto matches = [images, count](VkImage image) {
+		for (int i = 0; i < count; i++) if (image == (VkImage)images[i]) return true;
+		return false;
+	};
+	auto& frame = device->frames[device->frameIndex];
+	if (frame.is_recording)
+	{
+		MGVK_FlushCommands(device, frame);
+		MGVK_BeginCommandBuffer(frame.commandBuffer);
+	}
+	else
+	{
+		std::lock_guard lock(device->queueMutex);
+		vkQueueWaitIdle(device->queue);
+	}
+	MGVK_DestroyTargetSets(device, [matches](const MGVK_TargetSetCache* cache) { return matches(cache->set.density.image); });
+	for (auto target : device->all_textures)
+		if (matches(target->density.image)) target->density = {};
+	device->targets.density = {};
+	device->renderTargetDirty = true;
+	device->pipelineStateDirty = true;
+}
