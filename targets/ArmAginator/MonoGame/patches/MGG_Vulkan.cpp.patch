+MG_EXPORT void MGVK_RequestFragmentDensityMap(mgbool requested) { s_fdmRequested = requested != 0; }
+MG_EXPORT mgint MGVK_FragmentDensityMapEnabled(MGG_GraphicsDevice* device)
+{
+	return device != nullptr && device->fdmEnabled ? 1 | (device->fdmLayered ? 2 : 0) | (device->fdmOffset ? 4 : 0) : 0;
+}
+MG_EXPORT mgint MGVK_FragmentDensityMapProbe(MGG_GraphicsDevice* device, uint32_t* values, mgint count)
+{
+	if (device == nullptr || values == nullptr || count < 10) return 0;
+	memcpy(values, device->fdmProbe, sizeof(device->fdmProbe));
+	return 10;
+}
