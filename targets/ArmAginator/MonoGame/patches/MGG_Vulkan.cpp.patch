+// ArmAgedon: the runtime's own per-draw work (see MGVK_Perf), read and reset by the renderer's [perf] line: `seconds` gets
+// the four times (the descriptor update, its fill, its constant buffer copies, the pipeline binds) and `counters` the
+// counts, both in the order of MGVK_Perf's fields. Returns their number, 0 when ARMA_VK_PERF is off.
+// ArmAgedon: where the runtime's GPU memory goes (the renderer's [gpu-res] line): VMA's device memory blocks and the
+// allocations in them (a block is allocated whole, so blocks - allocations is reserved and unused), the frames' uniform
+// rings, and VMA's view of the heaps (usage and budget, summed over the device-local heaps). values: block bytes, block
+// count, allocation bytes, allocation count, uniform ring bytes, uniform ring count, heap usage, heap budget. Returns
+// how many it wrote.
+MG_EXPORT mgint MGVK_ReadMemory(MGG_GraphicsDevice* device, uint64_t* values, mgint count)
+{
+	if (device == nullptr || device->allocator == VK_NULL_HANDLE || values == nullptr)
+		return 0;
+	VmaTotalStatistics stats;
+	vmaCalculateStatistics(device->allocator, &stats);
+	uint64_t ringBytes = 0, rings = 0;
+	for (auto& frame : device->frames)
+		for (auto* ring : frame.uniformChain)
+		{
+			ringBytes += (uint64_t)ring->dataSize;
+			rings++;
+		}
+	const VkPhysicalDeviceMemoryProperties* props = nullptr;
+	vmaGetMemoryProperties(device->allocator, &props);
+	VmaBudget budgets[VK_MAX_MEMORY_HEAPS];
+	vmaGetHeapBudgets(device->allocator, budgets);
+	uint64_t usage = 0, budget = 0;
+	for (uint32_t h = 0; props != nullptr && h < props->memoryHeapCount; h++)
+		if (props->memoryHeaps[h].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT)
+		{
+			usage += budgets[h].usage;
+			budget += budgets[h].budget;
+		}
+	const uint64_t all[] = {
+		stats.total.statistics.blockBytes, stats.total.statistics.blockCount,
+		stats.total.statistics.allocationBytes, stats.total.statistics.allocationCount,
+		ringBytes, rings, usage, budget,
+	};
+	mgint n = (mgint)std::min<size_t>((size_t)count, sizeof(all) / sizeof(all[0]));
+	for (mgint i = 0; i < n; i++)
+		values[i] = all[i];
+	return n;
+}
+
+MG_EXPORT mgint MGVK_ReadPerf(double* seconds, uint64_t* counters, mgint maxCounters)
+{
+	if (!g_mgvkPerf.enabled)
+		return 0;
+	if (seconds != nullptr)
+	{
+		seconds[0] = g_mgvkPerf.tSets;
+		seconds[1] = g_mgvkPerf.tSetFills;
+		seconds[2] = g_mgvkPerf.tUbCopies;
+		seconds[3] = g_mgvkPerf.tPipeline;
+		seconds[4] = g_mgvkPerf.tDraw;
+		seconds[5] = g_mgvkPerf.tDriver;
+		seconds[6] = g_mgvkPerf.tRenderPass;
+		seconds[7] = g_mgvkPerf.tBufferSet;
+		seconds[8] = g_mgvkPerf.tBindSets;
+		seconds[9] = g_mgvkPerf.tBindVertex;
+		seconds[10] = g_mgvkPerf.tBindIndex;
+		seconds[11] = g_mgvkPerf.tDrawCmd;
+		seconds[12] = g_mgvkPerf.tDrawCmdAfterBind;
+	}
+	const uint64_t values[] = {
+		g_mgvkPerf.sets, g_mgvkPerf.setFills, g_mgvkPerf.setWrites, g_mgvkPerf.setAllocs,
+		g_mgvkPerf.ubCopies, g_mgvkPerf.ubBytes, g_mgvkPerf.pipelineBinds, g_mgvkPerf.passes,
+		g_mgvkPerf.textureSets, g_mgvkPerf.bufferSets, g_mgvkPerf.bufferBytes, g_mgvkPerf.draws,
+		g_mgvkPerf.indexBinds, g_mgvkPerf.indexRebinds, g_mgvkPerf.vertexBinds, g_mgvkPerf.setBinds,
+		g_mgvkPerf.drawsAfterBind,
+	};
+	mgint count = (mgint)std::min<size_t>((size_t)maxCounters, sizeof(values) / sizeof(values[0]));
+	for (mgint i = 0; i < count; i++)
+		counters[i] = values[i];
+	MGVK_Perf fresh; // counted again from now on
+	fresh.enabled = true;
+	g_mgvkPerf = fresh;
+	return count;
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// ArmAgedon: asynchronous texture readback. MGG_Texture_GetData submits its copy and waits for it, and so for all the GPU
+// work queued before it (a reflection-probe capture read back the frame after it was drawn waited ~24 ms on an Adreno 8cx
+// Gen 3). MGVK_ReadbackBegin records the same copy into a staging buffer and submits it with a fence; MGVK_ReadbackEnd
+// copies the data out once that fence has signaled. Patch kept in ArmAgedon/MonoGameRuntime/.
+// ---------------------------------------------------------------------------------------------------------------------
+
+struct MGVK_Readback
+{
+	MGG_Buffer buffer;
+	VkCommandBuffer commandBuffer = VK_NULL_HANDLE;
+	VkFence fence = VK_NULL_HANDLE;
+	mgint dataBytes = 0;
+};
+
+/// Starts copying a region of the texture into a staging buffer (MGG_Texture_GetData's arguments): the readback to pass to
+/// MGVK_ReadbackEnd. A target drawn into in the frame being recorded has that frame's commands submitted first, as
+/// MGG_Texture_GetData does.
+MG_EXPORT void* MGVK_ReadbackBegin(MGG_GraphicsDevice* device, MGG_Texture* texture, mgint level, mgint slice, mgint x, mgint y, mgint z, mgint width, mgint height, mgint depth, mgint dataBytes)
+{
+	assert(device != nullptr);
+	assert(texture != nullptr);
+	assert(dataBytes > 0);
+
+	MGVK_ClampAndValidateTextureRegion(texture, level, slice, x, y, z, width, height, depth);
+
+	std::lock_guard lock(device->transferMutex);
+	MGVK_WaitPendingTransfers(device, texture);
+
+	std::lock_guard lock2(device->queueMutex);
+
+	auto& frame = device->frames[device->frameIndex];
+	bool restart_frame = false;
+	if (texture->isTarget && frame.is_recording && texture->frame == device->frame)
+	{
+		MGVK_FlushCommands(device, frame);
+		restart_frame = true;
+	}
+
+	auto readback = new MGVK_Readback();
+	readback->dataBytes = dataBytes;
+	MGVK_BufferCreate(device, dataBytes, VK_BUFFER_USAGE_TRANSFER_DST_BIT, VMA_MEMORY_USAGE_CPU_ONLY, &readback->buffer);
+	VK_SET_OBJECT_NAME(device->device, readback->buffer.buffer, VK_OBJECT_TYPE_BUFFER, "MGVK_ReadbackBegin::stagingBuffer");
+
+	VkImageLayout originalLayout = texture->layouts[level];
+	VkImageAspectFlags aspectMask = DetermineAspectMask(texture->info.format);
+
+	VkCommandBuffer copyCmd = MGVK_BeginNewCommandBuffer(device, device->transferPool);
+	MGVK_CmdTransitionImageLayout(copyCmd, texture->image, originalLayout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, aspectMask, level, 1, slice, 1);
+	MGVK_CmdCopyImageToBuffer(copyCmd, texture->image, readback->buffer.buffer, x, y, z, level, slice, width, height, depth, aspectMask);
+	MGVK_CmdTransitionImageLayout(copyCmd, texture->image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, originalLayout, aspectMask, level, 1, slice, 1);
+	vkEndCommandBuffer(copyCmd);
+	readback->commandBuffer = copyCmd;
+
+	VkFenceCreateInfo fenceInfo = { VK_STRUCTURE_TYPE_FENCE_CREATE_INFO };
+	VK_CHECK_RESULT(vkCreateFence(device->device, &fenceInfo, nullptr, &readback->fence));
+	VK_SET_OBJECT_NAME(device->device, readback->fence, VK_OBJECT_TYPE_FENCE, "MGVK_ReadbackBegin.fence");
+
+	VkSubmitInfo submitInfo = { VK_STRUCTURE_TYPE_SUBMIT_INFO };
+	submitInfo.commandBufferCount = 1;
+	submitInfo.pCommandBuffers = &copyCmd;
+	VK_CHECK_RESULT(vkQueueSubmit(device->queue, 1, &submitInfo, readback->fence));
+
+	if (restart_frame)
+		MGVK_BeginCommandBuffer(frame.commandBuffer);
+
+	return readback;
+}
+
+/// 1 when the copy has finished: up to dataBytes of it copied into data (none when data is null) and the readback freed.
+/// 0 while it has not finished and wait is 0 (call again later); wait != 0 waits for it.
+MG_EXPORT mgint MGVK_ReadbackEnd(MGG_GraphicsDevice* device, void* handle, mgbyte* data, mgint dataBytes, mgint wait)
+{
+	assert(device != nullptr);
+	assert(handle != nullptr);
+
+	auto readback = (MGVK_Readback*)handle;
+	if (wait)
+		vkWaitForFences(device->device, 1, &readback->fence, VK_TRUE, UINT64_MAX);
+	else if (vkGetFenceStatus(device->device, readback->fence) != VK_SUCCESS)
+		return 0;
+
+	if (data != nullptr)
+	{
+		void* src;
+		vmaMapMemory(device->allocator, readback->buffer.allocation, &src);
+		memcpy(data, src, std::min(dataBytes, readback->dataBytes));
+		vmaUnmapMemory(device->allocator, readback->buffer.allocation);
+	}
+
+	vkDestroyFence(device->device, readback->fence, nullptr);
+	{
+		std::lock_guard lock(device->transferMutex);
+		vkFreeCommandBuffers(device->device, device->transferPool, 1, &readback->commandBuffer);
 	}
+	vmaDestroyBuffer(device->allocator, readback->buffer.buffer, readback->buffer.allocation);
+	delete readback;
+	return 1;
+}
+
+// ArmAgedon: seconds since the last read on this thread, plus actual Present count.
+// 8 is inclusive next-frame preparation; 9/10 are its fence/acquisition children.
+MG_EXPORT mgint MGVK_ReadPresentTiming(double* seconds, uint64_t* frames, mgint count)
+{
+    if (!armaPresentEnabled || !seconds || !frames || count < 14) return 0;
+    for (int i = 0; i < 11; ++i) seconds[i] = armaPresent.seconds[i];
+    seconds[11] = seconds[8] - seconds[9] - seconds[10];
+    seconds[12] = seconds[0];
+    for (int i = 1; i <= 8; ++i) seconds[12] -= seconds[i];
+    seconds[13] = armaPresent.maximum;
+    *frames = armaPresent.frames;
+    armaPresent = {};
+    return 14;
 }
