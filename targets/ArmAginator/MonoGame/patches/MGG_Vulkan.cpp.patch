+static void MGVK_SplitNames(const char* names, std::vector<std::string>& out)
+{
+	out.clear();
+	if (names == nullptr)
+		return;
+	std::istringstream stream(names);
+	std::string name;
+	while (stream >> name)
+		out.push_back(name);
