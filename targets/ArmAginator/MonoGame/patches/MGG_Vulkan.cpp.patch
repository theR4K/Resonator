+// ArmAgedon: graphics-thread diagnostics for resize regression checks; no GPU work.
+MG_EXPORT mgint MGVK_GetBackbufferState(MGG_GraphicsDevice* device, mgint* values, mgint count)
+{
+    if (device == nullptr || values == nullptr || count < 6) return 0;
+    values[0] = (mgint)device->swapchainWidth;
+    values[1] = (mgint)device->swapchainHeight;
+    values[2] = (mgint)device->viewport.width;
+    values[3] = (mgint)device->viewport.height;
+    values[4] = (mgint)device->scissor.extent.width;
+    values[5] = (mgint)device->scissor.extent.height;
+    return 6;
+}
