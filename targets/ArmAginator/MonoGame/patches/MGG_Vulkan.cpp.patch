+/// Copy a render target into an external image owned by someone else (an OpenXR swapchain image), in order with
+/// everything MonoGame recorded so far. Like MGG_Texture_GetData: the frame's command buffer is submitted and waited
+/// on first, the copy runs in its own command buffer (waited on), then the frame resumes recording.
+/// The external image is expected in COLOR_ATTACHMENT_OPTIMAL and is left in it (OpenXR's contract for
+/// acquired/released color swapchain images). Same-size, copy-compatible formats use vkCmdCopyImage (raw bytes, e.g.
+/// R8G8B8A8_UNORM -> R8G8B8A8_SRGB without re-encoding); otherwise vkCmdBlitImage (scales/flips/converts).
+/// Returns 0 on success.
+MG_EXPORT mgint MGVK_CopyToExternalImage(MGG_GraphicsDevice* device, MGG_Texture* source, uint64_t externalImage, mgint externalFormat, mgint width, mgint height, mgbool flipY)
+{
+	assert(device != nullptr);
+	if (source == nullptr || externalImage == 0 || source->image == VK_NULL_HANDLE)
+		return -1;
+
+	std::lock_guard lock(device->transferMutex);
+	MGVK_WaitPendingTransfers(device, source);
+	std::lock_guard lock2(device->queueMutex);
+
+	auto& frame = device->frames[device->frameIndex];
+	bool restart_frame = false;
+	if (frame.is_recording)
+	{
+		MGVK_FlushCommands(device, frame);
+		restart_frame = true;
+	}
+
+	VkImage src = source->image;
+	VkImage dst = (VkImage)externalImage;
+	VkImageLayout srcLayout = source->layouts[0];
+	if (srcLayout == VK_IMAGE_LAYOUT_UNDEFINED)
+		srcLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+
+	VkCommandBuffer cmd = MGVK_BeginNewCommandBuffer(device, device->transferPool);
+
+	VkImageMemoryBarrier barriers[2] = {};
+	for (auto& b : barriers)
+	{
+		b.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER;
+		b.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		b.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+		b.subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 };
+	}
+	barriers[0].image = src;
+	barriers[0].oldLayout = srcLayout;
+	barriers[0].newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+	barriers[0].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_SHADER_READ_BIT;
+	barriers[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+	barriers[1].image = dst;
+	barriers[1].oldLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+	barriers[1].newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barriers[1].srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+	barriers[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+
+	int32_t sw = (int32_t)source->info.extent.width, sh = (int32_t)source->info.extent.height;
+	bool rgba8Pair = (source->info.format == VK_FORMAT_R8G8B8A8_UNORM || source->info.format == VK_FORMAT_R8G8B8A8_SRGB)
+		&& (externalFormat == VK_FORMAT_R8G8B8A8_UNORM || externalFormat == VK_FORMAT_R8G8B8A8_SRGB);
+	if (!flipY && sw == width && sh == height && (rgba8Pair || (mgint)source->info.format == externalFormat))
+	{
+		VkImageCopy region = {};
+		region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		region.extent = { (uint32_t)width, (uint32_t)height, 1 };
+		vkCmdCopyImage(cmd, src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	}
+	else
+	{
+		VkImageBlit blit = {};
+		blit.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		blit.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+		blit.srcOffsets[0] = { 0, 0, 0 };
+		blit.srcOffsets[1] = { sw, sh, 1 };
+		blit.dstOffsets[0] = { 0, flipY ? height : 0, 0 };
+		blit.dstOffsets[1] = { width, flipY ? 0 : height, 1 };
+		vkCmdBlitImage(cmd, src, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, dst, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit, VK_FILTER_LINEAR);
+	}
+
+	barriers[0].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+	barriers[0].newLayout = srcLayout;
+	barriers[0].srcAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+	barriers[0].dstAccessMask = VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+	barriers[1].oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+	barriers[1].newLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+	barriers[1].srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+	barriers[1].dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+	vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr, 2, barriers);
+
+	MGVK_ExecuteAndFreeCommandBuffer(device, cmd, device->transferPool);
+	source->layouts[0] = srcLayout;
+
+	if (restart_frame)
+		MGVK_BeginCommandBuffer(frame.commandBuffer);
+	return 0;
+}
