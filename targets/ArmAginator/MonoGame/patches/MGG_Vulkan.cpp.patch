+// ArmAgedon vk-depth-discard: nothing reads `texture`'s depth / stencil after its passes this frame (on) or again (off)
+MG_EXPORT void MGVK_SetDiscardDepth(MGG_GraphicsDevice* device, MGG_Texture* texture, mgbool on)
+{
