+// ArmAgedon: where a drawn frame's CPU time goes inside the runtime (docs/renderer-constant-buffers.md). A Materials.fx draw
+// costs ~11 us of CPU here against ~1.8 us for a Depth.fx one and a profiler cannot split that: these are plain interop
+// calls, so their native time shows as the managed caller's. ARMA_VK_PERF=1 counts and times the per-draw work (two
+// QueryPerformanceCounter calls per measured block) for the [perf] line, read by MGVK_ReadPerf; when it is off, every
+// instrumented block is one bool test.
+struct MGVK_Perf
+{
+	bool enabled = false;
+	// counts over the window since the last MGVK_ReadPerf (the order MGVK_ReadPerf writes them)
+	uint64_t sets = 0;           // MGVK_UpdateDescriptors calls that had dirty state to apply
+	uint64_t setFills = 0;       // of those, the ones that needed a descriptor set filled (a cache miss)
+	uint64_t setWrites = 0;      // descriptor writes of those fills
+	uint64_t setAllocs = 0;      // descriptor sets allocated from the pools
+	uint64_t ubCopies = 0;       // constant buffers copied into the frame's uniform buffer
+	uint64_t ubBytes = 0;        // and their bytes
+	uint64_t pipelineBinds = 0;  // vkCmdBindPipeline calls
+	uint64_t passes = 0;         // vkCmdBeginRenderPass calls
+	uint64_t textureSets = 0;    // MGG_GraphicsDevice_SetTexture / SetSamplerState calls
+	uint64_t bufferSets = 0;     // MGG_Buffer_SetData calls
+	uint64_t bufferBytes = 0;    // and their bytes
+	uint64_t draws = 0;          // MGG_GraphicsDevice_Draw / DrawIndexed / DrawIndexedInstanced calls
+	// seconds, the same window (the eight MGVK_ReadPerf writes)
+	double tSets = 0;            // MGVK_UpdateDescriptors, all of it
+	double tSetFills = 0;        // its fill: the set, its writes and vkUpdateDescriptorSets
+	double tUbCopies = 0;        // its constant buffer copies
+	double tPipeline = 0;        // MGVK_UpdatePipeline's pipeline bind (its rare pipeline creations too)
+	double tDraw = 0;            // the draw calls, all of them (render pass, pipeline, descriptors, driver)
+	double tDriver = 0;          // the driver's vkCmdBindDescriptorSets / BindVertexBuffers / BindIndexBuffer / Draw*
+	double tRenderPass = 0;      // the draw calls' MGVK_UpdateRenderPass (pass changes, their clears and barriers)
+	double tBufferSet = 0;       // MGG_Buffer_SetData, all of it
+	double tBindSets = 0;        // of tDriver: vkCmdBindDescriptorSets
+	double tBindVertex = 0;      // of tDriver: vkCmdBindVertexBuffers
+	double tBindIndex = 0;       // of tDriver: vkCmdBindIndexBuffer
+	uint64_t indexBinds = 0;     // vkCmdBindIndexBuffer calls
+	uint64_t indexRebinds = 0;   // of those, skipped: the same buffer and type as bound in this command buffer already
+	uint64_t vertexBinds = 0;    // vkCmdBindVertexBuffers calls
+	uint64_t setBinds = 0;       // vkCmdBindDescriptorSets calls
+	uint64_t drawsAfterBind = 0; // draws with a pipeline, descriptor, vertex or index bind or a render pass since the last one
+	double tDrawCmd = 0;         // of tDriver: vkCmdDraw / vkCmdDrawIndexed
+	double tDrawCmdAfterBind = 0; // of tDrawCmd: the drawsAfterBind ones (a driver that emits bound state at the draw)
+	bool boundSinceDraw = true;
+};
+static MGVK_Perf g_mgvkPerf;
+
+// ArmAgedon: the index buffer bound in the command buffer being recorded (MGVK_BindIndexBuffer); MGVK_BeginCommandBuffer
+// forgets it, the frames' command buffers are recorded again
+static VkCommandBuffer g_mgvkIndexCommands = VK_NULL_HANDLE;
+static VkBuffer g_mgvkIndexBuffer = VK_NULL_HANDLE;
+static VkIndexType g_mgvkIndexType = VK_INDEX_TYPE_UINT16;
+
+static double MGVK_PerfNow()
+{
+#if defined(_WIN32)
+	static const double frequency = []() { LARGE_INTEGER f; QueryPerformanceFrequency(&f); return (double)f.QuadPart; }();
+	LARGE_INTEGER c;
+	QueryPerformanceCounter(&c);
+	return (double)c.QuadPart / frequency;
+#else
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (double)ts.tv_sec + 1e-9 * (double)ts.tv_nsec;
+#endif
+}
+
+/// <summary>Adds the time to `to` when ARMA_VK_PERF is on; the branch is all it costs when it is off.</summary>
+struct MGVK_PerfTimer
+{
+	double& to;
+	double start;
+	MGVK_PerfTimer(double& to) : to(to), start(g_mgvkPerf.enabled ? MGVK_PerfNow() : 0.0) {}
+	~MGVK_PerfTimer() { if (g_mgvkPerf.enabled) to += MGVK_PerfNow() - start; }
+};
+
+/// <summary>Times the driver's draw command (tDrawCmd), split by whether anything was bound since the previous draw.</summary>
+struct MGVK_PerfDrawTimer
+{
+	double start;
+	MGVK_PerfDrawTimer() : start(g_mgvkPerf.enabled ? MGVK_PerfNow() : 0.0) {}
+	~MGVK_PerfDrawTimer()
+	{
+		if (!g_mgvkPerf.enabled)
+			return;
+		double t = MGVK_PerfNow() - start;
+		g_mgvkPerf.tDrawCmd += t;
+		if (g_mgvkPerf.boundSinceDraw)
+		{
+			g_mgvkPerf.tDrawCmdAfterBind += t;
+			g_mgvkPerf.drawsAfterBind++;
+		}
+		g_mgvkPerf.boundSinceDraw = false;
+	}
+};
+
+// ArmAgedon: binds the index buffer unless this command buffer has it bound already. The stock code bound it at every
+// draw ("TODO: Detect if we need to rebind the same index buffer?"): on the Cloud Home 54% of the binds were the same one.
+static void MGVK_BindIndexBuffer(VkCommandBuffer commandBuffer, VkBuffer buffer, MGIndexElementSize size)
+{
+	auto type = size == MGIndexElementSize::SixteenBits ? VK_INDEX_TYPE_UINT16 : VK_INDEX_TYPE_UINT32;
+	if (g_mgvkPerf.enabled)
+		g_mgvkPerf.indexBinds++;
+	if (g_mgvkIndexCommands == commandBuffer && g_mgvkIndexBuffer == buffer && g_mgvkIndexType == type)
+	{
+		if (g_mgvkPerf.enabled)
+			g_mgvkPerf.indexRebinds++;
+		return;
+	}
+	g_mgvkIndexCommands = commandBuffer;
+	g_mgvkIndexBuffer = buffer;
+	g_mgvkIndexType = type;
+	g_mgvkPerf.boundSinceDraw = true;
+	MGVK_PerfTimer perfBindIndex(g_mgvkPerf.tBindIndex);
+	vkCmdBindIndexBuffer(commandBuffer, buffer, 0, type);
+}
 
 
