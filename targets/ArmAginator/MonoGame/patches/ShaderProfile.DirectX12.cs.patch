+        /// order, so the effect comes out the same.
+        /// </summary>
+        internal override void Precompile(ShaderResult shaderResult, IReadOnlyList<(string function, string model, bool isVertexShader)> shaders)
+        {
+            int jobs = PrecompileJobs;
+            if (jobs <= 1)
+                return;
+            System.Threading.Tasks.Parallel.ForEach(shaders, new System.Threading.Tasks.ParallelOptions { MaxDegreeOfParallelism = jobs }, s =>
+            {
+                _precompiled[(s.function, s.model, s.isVertexShader)] = CompileDxil(shaderResult, s.function, s.model, s.isVertexShader);
+            });
+        }
 
