+        /// <summary>
+        /// ArmAgedon: DXC, retried. dxc.exe (MonoGame.Tool.Dxc 1.8.2505.11) crashes now and then on the same input that
+        /// compiles the next time (heap corruption, access violations, a "generated SPIR-V is invalid" once): about one run in
+        /// a few hundred on the large Materials.fx, one of its ~200 runs, so most builds of it failed. A real compile error
+        /// fails every attempt and is reported from the last one.
+        /// </summary>
+        private static int RunDxc(string args, out string stdout, out string stderr)
+        {
+            int result = 0;
+            stdout = stderr = string.Empty;
+            for (int attempt = 0; attempt < 4; attempt++)
+            {
+                result = Dxc.Run(args, out stdout, out stderr);
+                if (result == 0)
+                    break;
             }
+            return result;
         }
