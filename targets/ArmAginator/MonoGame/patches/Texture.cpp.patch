+void Texture::InitializeIfNeeded(ID3D12GraphicsCommandList* commandList) {
+    if (!impl->m_needsInit)
+        return;
+    impl->m_needsInit = false;
+
+    // DiscardResource wants the render target / depth write state; the tracked state is left as it was
