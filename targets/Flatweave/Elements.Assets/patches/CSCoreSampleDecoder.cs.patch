+	// Flatweave: the official CSCore has neither CodecFactory.GetCodec(Stream, string) nor an OGG codec. This is the codec
+	// set Yellow Dog Man's fork registers (WAV PCM/float, FLAC, AIFF, OGG Vorbis; MP3/MediaFoundation removed), chosen by
+	// extension the same way.
+	private static IWaveSource OpenCodec(Stream stream, string extension)
+	{
+		switch (extension.ToLowerInvariant())
+		{
+		case "wav":
+		case "wave":
+		{
+			IWaveSource res = new WaveFileReader(stream);
+			if (res.WaveFormat.WaveFormatTag != AudioEncoding.Pcm && res.WaveFormat.WaveFormatTag != AudioEncoding.IeeeFloat && res.WaveFormat.WaveFormatTag != AudioEncoding.Extensible)
+			{
+				res.Dispose();
+				res = null;
+			}
+			return res;
+		}
+		case "flac":
+		case "fla":
+			return new FlacFile(stream);
+		case "aiff":
+		case "aif":
+		case "aifc":
+			return new CSCore.Codecs.AIFF.AiffReader(stream);
+		case "ogg":
+			return new NVorbisSource(stream).ToWaveSource();
+		default:
+			throw new NotSupportedException("Didn't find suitable codec for " + extension);
+		}
 	}
 
