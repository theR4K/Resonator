+	}
+
+	public static void Decompose(this Matrix4x4 m, out Vector3D scaling, out Quaternion rotation, out Vector3D translation)
+	{
+		Matrix4x4.Decompose(Matrix4x4.Transpose(m), out scaling, out rotation, out translation);
+	}
