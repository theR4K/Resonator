+	// Flatweave: AssimpNet's matrix helpers, which AssimpNetter dropped for System.Numerics. Its matrices hold assimp's
+	// aiMatrix4x4 as is (column vectors, translation in M14/M24/M34), while System.Numerics' builders and Decompose assume
+	// row vectors - so those go through a transpose. Multiplication and inversion are convention-free.
+	public static Matrix4x4 AssimpScaling(Vector3D scale)
+	{
+		return Matrix4x4.CreateScale(scale);
+	}
+
+	public static Matrix4x4 AssimpTranslation(Vector3D translation)
+	{
+		return Matrix4x4.Transpose(Matrix4x4.CreateTranslation(translation));
+	}
+
+	public static Matrix4x4 GetMatrix(this Quaternion q)
+	{
+		return Matrix4x4.Transpose(Matrix4x4.CreateFromQuaternion(q));
+	}
+
