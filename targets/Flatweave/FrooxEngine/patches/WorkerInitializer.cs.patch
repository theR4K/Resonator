+	// Flatweave: the flattener clears InitOnly on sync-member fields (C# cannot store into readonly outside a ctor) and marks
+	// them [Resonator.FlattenedInitOnly]; the engine's InitOnly-based reflection (sync member discovery, data-model hash) reads both.
+	internal static bool IsInitOnlyOrFlattened(this FieldInfo field)
+	{
+		if (field.IsInitOnly)
+		{
+			return true;
+		}
+		foreach (CustomAttributeData attribute in field.CustomAttributes)
+		{
+			if (attribute.AttributeType.FullName == "Resonator.FlattenedInitOnlyAttribute")
+			{
+				return true;
+			}
 		}
+		return false;
 	}
 
