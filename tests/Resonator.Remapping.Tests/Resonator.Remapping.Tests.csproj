<Project Sdk="Microsoft.NET.Sdk">
  <!-- Executable assertions for remapping and Assimp adapters. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <DefineConstants Condition="Exists('$(ResoniteDir)/AssimpNet.dll')">$(DefineConstants);HAS_ASSIMP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Resonator.Pipeline/Resonator.Pipeline.csproj" />
    <ProjectReference Include="../../src/Flatweave.Adapter/Flatweave.Adapter.csproj" />
    <Reference Include="AssimpNet" HintPath="$(ResoniteDir)/AssimpNet.dll" Aliases="legacy" Condition="Exists('$(ResoniteDir)/AssimpNet.dll')" />
  </ItemGroup>
</Project>
